}

union CreatePlayerResult = CreatePlayerResponse | PlayerAlreadyExistsError
union UpdatePlayerResult = UpdatePlayerResponse | PlayerNotFoundError
union DeletePlayerResult = DeletePlayerResponse | PlayerNotFoundError# ============================================================================
# Resource / File Management (v2)
#
# Resources are files (images, documents, videos) stored in S3.
# Clients interact with resources through fields on parent types
# (User.profilePicture, Game.media, MediaChatMessage.resource)
# rather than through generic polymorphic queries.
#
# Backend-only concerns (ownerType, storageType, resourceStatus) are not
# exposed in the public schema.
# ============================================================================

# ============================================================================
# Resource Types
# ============================================================================

"""
A stored file. Concrete types carry format-specific metadata.
"""
interface Resource implements Node {
  id: ID!
  filename: String!
  """
  File size in bytes.
  """
  size: Long!
  mimeType: String!
  """
  Presigned download URL. Ephemeral — generated on demand by the resolver.
  """
  downloadUrl: String!
  createdDate: DateTime!
}

"""
An image resource with dimension and thumbnail metadata.
Dimensions and thumbnail are extracted server-side after upload and may
not be immediately available (null until processing completes).
"""
type ImageResource implements Resource & Node {
  id: ID!
  filename: String!
  size: Long!
  mimeType: String!
  downloadUrl: String!
  createdDate: DateTime!
  width: Int
  height: Int
  """
  Presigned URL for a smaller thumbnail variant.
  Null if no thumbnail has been generated yet.
  """
  thumbnailUrl: String
}

"""
A generic file resource (documents, etc.).
"""
type FileResource implements Resource & Node {
  id: ID!
  filename: String!
  size: Long!
  mimeType: String!
  downloadUrl: String!
  createdDate: DateTime!
}

type ResourceEdge implements Edge {
  cursor: String!
  node: Resource!
}

type ResourceConnection implements Connection {
  edges: [ResourceEdge!]!
  pageInfo: PageInfo!
}

# ============================================================================
# Upload Flow — Phase 1: Request Upload
#
# Client calls requestUpload with file metadata and an upload context
# that identifies what entity the resource will be attached to.
# Server returns a presigned PUT URL for the client to upload directly to S3.
# ============================================================================

"""
Identifies what entity the resource will be attached to.
Enables per-context server-side validation (e.g., profile pictures must be images).
"""
input UploadContextInput @oneOf {
  """
  Upload a profile picture for the current user.
  """
  userProfilePicture: UserProfilePictureUploadContext
  """
  Upload media (photo/video) to a game.
  """
  gameMedia: GameMediaUploadContext
  """
  Upload a file/image to a chat room. The resource is linked to the
  chat message when sendChatMessage is called with the resourceId.
  For chat media, sendChatMessage is the confirmation step — do NOT
  call confirmUpload separately.
  """
  chatMedia: ChatMediaUploadContext
}

input UserProfilePictureUploadContext {
  """
  If true, this is a placeholder upload (no resize support yet).
  """
  placeholder: Boolean
}

input GameMediaUploadContext {
  gameId: ID!
}

input ChatMediaUploadContext {
  chatRoomId: ID!
}

input RequestUploadInput {
  filename: String!
  mimeType: String!
  size: Long!
  context: UploadContextInput!
}

type RequestUploadResponse {
  """
  Presigned PUT URL. Client uploads file bytes directly to this URL.
  Null when using LOCAL storage (dev environments only).
  """
  uploadUrl: String
  """
  Resource ID. Use this to confirm the upload (phase 2) or to
  reference the resource when sending a chat message.
  """
  resourceId: ID!
}

# ============================================================================
# Upload Flow — Phase 2: Confirm Upload
#
# After the client uploads the file to S3, it calls confirmUpload
# to transition the resource from REQUESTED to PERMANENT.
#
# Exception: chat media resources are confirmed automatically when
# sendChatMessage is called — no separate confirmUpload needed.
# ============================================================================

input ConfirmUploadInput {
  resourceId: ID!
}

type ConfirmUploadResponse {
  resource: Resource!
}

# ============================================================================
# Delete Resource
# ============================================================================

input DeleteResourceInput {
  resourceId: ID!
}

type DeleteResourceResponse implements DeleteResponse {
  id: ID!
}

# ============================================================================
# Resource Result Unions
# ============================================================================

union RequestUploadResult = RequestUploadResponse | InvalidUploadContextError
union ConfirmUploadResult = ConfirmUploadResponse | ResourceNotFoundError
union DeleteResourceResult = DeleteResourceResponse | ResourceNotFoundError
scalar DateTime
scalar JSON
"""
A 64-bit signed integer. Represents values from -(2^63) to 2^63-1.
Serialized as a JSON number when within safe integer range, otherwise as a string.
"""
scalar Long

"""
The direction to sort results
"""
enum SortDirection {
  ASC
  DESC
}

"""
Node IDs are unique only within a type
"""
interface Node {
  id: ID!
}

interface Edge {
  cursor: String!
  node: Node!
}

interface Connection {
  edges: [Edge!]!
  pageInfo: PageInfo!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

interface DeleteResponse {
  id: ID!
}

interface HasLocation {
  location: Location
}

type Location {
  id: ID!
  name: String
  address: Address!
  coordinates: Coordinates
}

type Address {
  street: String!
  city: String!
  state: String!
  postalCode: String!
  country: String!
}

type Coordinates {
  latitude: Float!
  longitude: Float!
}

input LocationInput {
  name: String
  address: AddressInput!
  coordinates: CoordinatesInput
}

input AddressInput {
  street: String
  city: String
  state: String
  postalCode: String
  country: String!
}

input CoordinatesInput {
  latitude: Float!
  longitude: Float!
}

type Query {
  """
  Get a user by ID or username
  """
  user(input: QueryUserInput!): User
  """
  Get the user info for the current logged-in user.
  Returns additional private fields like email.
  """
  me: CurrentUser!
  """
  Search for users by name.
  """
  searchUsers(
    input: UserSearchInput!
    first: Int
    after: String
    last: Int
    before: String
  ): UserConnection!
  """
  Query friendships for the current user.
  Use filters to get pending requests, accepted friends, blocked users, etc.
  User must be authenticated.
  """
  friendships(
    input: FriendshipFilterInput
    first: Int
    after: String
    last: Int
    before: String
  ): FriendshipConnection!
  """
  Get a player by ID
  """
  player(id: ID!): Player
  """
  Get the player for the current logged-in user
  """
  currentPlayer: Player
  """
  Get a game by ID
  """
  game(id: ID!): Game
  """
  Query and filter games
  Filters are AND-ed together
  Sort entries are sorted in-order of the list
  """
  games(
    input: GameFilterInput!
    sort: [GameSortInput!]
    first: Int
    after: String
    last: Int
    before: String): GameConnection!
  """
  Query for notifications for the current user.
  Ordered by createdDate DESC (most recent first).
  Use `first` to fetch the most recent notifications; `after` to load older notifications.
  User must be authenticated.
  """
  notifications(
    first: Int
    after: String
    last: Int
    before: String
  ): NotificationConnection!
  """
  Get a chat room
  User must be authenticated.
  """
  chatRoom(id: ID!): ChatRoom
  """
  Query for chat rooms for the current user.
  Ordered by lastModifiedDate DESC (most recently active first).
  Use `first` to fetch the most recently active rooms; `after` to load older rooms.
  User must be authenticated.
  """
  chatRooms(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomConnection!
  """
  Find the direct message chat room between the current user and another user.
  Returns null if no DM exists.
  """
  directMessageChatRoom(userId: ID!): ChatRoom
  """
  Activity feed showing games that the current user and their friends participate in.
  Ordered by start date DESC (most recent first).
  Use `first` to fetch the most recent games; `after` to load older games.
  User must be authenticated.
  """
  friendsActivityFeed(
    first: Int
    after: String
    last: Int
    before: String
  ): GameConnection!
  """
  Query and filter basketball box scores
  """
  basketballBoxScores(
    input: GameIdsAndPlayerIdsInput!
    sort: [BoxScoreSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): BasketballBoxScoreConnection!
}

"""
Unless otherwise specified users must be authenticated before calling a mutation
When performing an update, only fields specified in the input will be updated
"""
type Mutation {
  """
  Create a new player.
  """
  createPlayer(input: CreatePlayerInput!): CreatePlayerResult!
  """
  Update an existing player.
  """
  updatePlayer(input: UpdatePlayerInput!): UpdatePlayerResult!
  """
  Delete a player.
  """
  deletePlayer(input: DeletePlayerInput!): DeletePlayerResult!
  """
  Create a game.
  """
  createGame(input: CreateGameInput!): CreateGameResult!
  """
  Update a game.
  """
  updateGame(input: UpdateGameInput!): UpdateGameResult!
  """
  Delete a game.
  """
  deleteGame(input: DeleteGameInput!): DeleteGameResult!
  """
  Add a participant to a game.
  Use teamInstance for team sports, individual for individual competition formats.
  """
  addGameParticipant(input: AddGameParticipantInput!): AddGameParticipantResult!
  """
  Add multiple participants to a game.
  """
  addGameParticipants(input: AddGameParticipantsInput!): AddGameParticipantsResult!
  """
  Update a participant in a game.
  Currently only team instances have updatable fields.
  """
  updateGameParticipant(input: UpdateGameParticipantInput!): UpdateGameParticipantResult!
  """
  Update multiple participants in a game.
  """
  updateGameParticipants(input: UpdateGameParticipantsInput!): UpdateGameParticipantsResult!
  """
  Remove a participant from a game.
  """
  removeGameParticipant(input: RemoveGameParticipantInput!): RemoveGameParticipantResult!
  """
  Remove multiple participants from a game.
  """
  removeGameParticipants(input: RemoveGameParticipantsInput!): RemoveGameParticipantsResult!
  """
  Add a player to an existing team instance.
  """
  addPlayerToTeamInstance(input: AddPlayerToTeamInstanceInput!): AddPlayerToTeamInstanceResult!
  """
  Add multiple players to an existing team instance.
  """
  addPlayersToTeamInstance(input: AddPlayersToTeamInstanceInput!): AddPlayersToTeamInstanceResult!
  """
  Remove a player from a team instance.
  """
  removePlayerFromTeamInstance(input: RemovePlayerFromTeamInstanceInput!): RemovePlayerFromTeamInstanceResult!
  """
  Remove multiple players from a team instance.
  """
  removePlayersFromTeamInstance(input: RemovePlayersFromTeamInstanceInput!): RemovePlayersFromTeamInstanceResult!
  """
  Start a game.
  Enables saving of statistics to the game.
  """
  startGame(input: StartGameInput!): StartGameResult!
  """
  End a game.
  """
  endGame(input: EndGameInput!): EndGameResult!
  """
  Finalize game results. After finalization, only the organizer can modify scores and statistics.
  """
  finalizeGameResults(input: FinalizeGameResultsInput!): FinalizeGameResultsResult!
  """
  Reverse finalization, allowing participants to edit scores and statistics again.
  """
  unfinalizeGameResults(input: UnfinalizeGameResultsInput!): UnfinalizeGameResultsResult!
  """
  Start a livestream on a game
  """
  startLivestream(input: StartLivestreamInput!): StartLivestreamResult!
  """
  End a livestream on a game
  """
  endLivestream(input: EndLivestreamInput!): EndLivestreamResult!
  """
  Update a livestream's title or description. Only the streamer can do this.
  """
  updateLivestream(input: UpdateLivestreamInput!): UpdateLivestreamResult!
  """
  Add a friend.
  """
  sendFriendRequest(input: SendFriendRequestInput!): SendFriendRequestResult!
  """
  Accept a friend request.
  """
  acceptFriendRequest(input: AcceptFriendRequestInput!): AcceptFriendRequestResult!
  """
  Decline a friend request.
  """
  declineFriendRequest(input: DeclineFriendRequestInput!): DeclineFriendRequestResult!
  """
  Unfriend a user.
  """
  unfriend(input: UnfriendRequestInput!): UnfriendResult!
  """
  Cancel a pending friend request you sent.
  Only the requester can cancel; only works on PENDING requests.
  """
  cancelFriendRequest(input: CancelFriendRequestInput!): CancelFriendRequestResult!
  """
  Block a user.
  Any logged-in user can block anyone. Works regardless of current
  friendship status (friends, pending, no relationship).
  The blocked record is stored with the caller as requester.
  """
  blockUser(input: BlockUserInput!): BlockUserResult!
  """
  Unblock a user you previously blocked.
  Only the person who initiated the block can unblock.
  The other person is not notified.
  """
  unblockUser(input: UnblockUserInput!): UnblockUserResult!
  """
  Read notifications for the current user
  """
  readNotifications(input: ReadNotificationsInput!): ReadNotificationsResult!
  """
  Create a direct message conversation with another user.
  Idempotent: returns the existing DM if one already exists.
  """
  createDirectMessage(input: CreateDirectMessageInput!): CreateDirectMessageResult!
  """
  Create a group chat with multiple users.
  """
  createGroupChat(input: CreateGroupChatInput!): CreateGroupChatResult!
  """
  Add a user to the chat room
  """
  addChatRoomMember(input: AddChatRoomMemberInput!): AddChatRoomMemberResult!
  """
  Remove a user from the chat room
  """
  removeChatRoomMember(input: RemoveChatRoomMemberInput !): RemoveChatRoomMemberResult!
  """
  Rename a group chat room. Only the Owner or Admin may rename.
  """
  renameChatRoom(input: RenameChatRoomInput!): RenameChatRoomResult!
  """
  Update a chat room member's role. Covers promote (MEMBER→ADMIN), demote (ADMIN→MEMBER),
  and ownership transfer (X→OWNER, which also demotes the current Owner to MEMBER).
  Only the Owner can change roles. Not applicable to direct message chat rooms.
  """
  updateChatRoomMemberRole(input: UpdateChatRoomMemberRoleInput!): UpdateChatRoomMemberRoleResult!
  """
  Leave a group chat room. The Owner must transfer ownership before leaving.
  """
  leaveChatRoom(input: LeaveChatRoomInput!): LeaveChatRoomResult!
  """
  Send a chat message
  """
  sendChatMessage(input: SendChatMessageInput!): SendChatMessageResult!
  """
  Update a chat message
  """
  updateChatMessage(input: UpdateChatMessageInput!): UpdateChatMessageResult!
  """
  Delete a message
  """
  deleteChatMessage(input: DeleteChatMessageInput!): DeleteChatMessageResult!
  """
  Save a box score for a basketball game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveBasketballBoxScore(
    input: SaveBasketballBoxScoreInput!
  ): SaveBasketballBoxScoreResult!
  """
  Save box scores for a basketball game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveBasketballBoxScores(
    input: SaveBasketballBoxScoresInput!
  ): SaveBasketballBoxScoresResult!
  """
  Request a presigned upload URL. Phase 1 of the upload flow.
  """
  requestUpload(input: RequestUploadInput!): RequestUploadResult!
  """
  Confirm that an upload is complete. Phase 2 of the upload flow.
  Transitions resource status from REQUESTED to PERMANENT.
  Not needed for chat media — sendChatMessage confirms chat resources automatically.
  """
  confirmUpload(input: ConfirmUploadInput!): ConfirmUploadResult!
  """
  Delete a resource and its backing file.
  """
  deleteResource(input: DeleteResourceInput!): DeleteResourceResult!
}

"""
All subscriptions require authentication via the WebSocket connection_init payload.
The server validates that the authenticated user is authorized for the requested resource
(e.g., must be a member of the chat room for chatEvents).
"""
type Subscription {
  """
  Subscribe to chat events (messages sent/updated/deleted, members added/removed) for the current user.
  User must be authenticated and will only receive notifications for chat rooms the are a part of
  """
  chatEvents: ChatEvent!
  """
  Subscribe to notification events for the current user.
  User must be authenticated.
  """
  notificationEvents: NotificationEvent!
}"""
Filter for box scores by game and/or player.
At least one of gameIds or playerIds must be provided.
"""
input GameIdsAndPlayerIdsInput {
    gameIds: [ID!]
    playerIds: [ID!]
}

"""
Box scores for basketball
"""
type BasketballBoxScore implements Node {
    id: ID!
    player: Player!
    game: Game!
    defensiveRebounds: Int
    offensiveRebounds: Int
    totalRebounds: Int
    assists: Int
    steals: Int
    blocks: Int
    turnovers: Int
    personalFouls: Int
    points: Int
    threePointersMade: Int
    threePointersAttempted: Int
    threePointerPercentage: Float
    twoPointersMade: Int
    twoPointersAttempted: Int
    twoPointerPercentage: Float
    freeThrowsMade: Int
    freeThrowsAttempted: Int
    freeThrowPercentage: Float
    fieldGoalsMade: Int
    fieldGoalsAttempted: Int
    fieldGoalPercentage: Float
}

type BasketballBoxScoreEdge implements Edge{
    node: BasketballBoxScore!
    cursor: String!
}

type BasketballBoxScoreConnection implements Connection{
    edges: [BasketballBoxScoreEdge!]!
    pageInfo: PageInfo!
}

enum BoxScoreSortField {
    POINTS
    ASSISTS
    TOTAL_REBOUNDS
    STEALS
    BLOCKS
}

input BoxScoreSortInput {
    field: BoxScoreSortField!
    direction: SortDirection = ASC
}

input SaveBasketballBoxScoresInput {
    basketballBoxScores: [SaveBasketballBoxScoreInput!]!
}

input SaveBasketballBoxScoreInput {
    playerId: ID!
    gameId: ID!
    defensiveRebounds: Int
    offensiveRebounds: Int
    assists: Int
    steals: Int
    blocks: Int
    turnovers: Int
    personalFouls: Int
    threePointersMade: Int
    threePointersAttempted: Int
    twoPointersMade: Int
    twoPointersAttempted: Int
    freeThrowsMade: Int
    freeThrowsAttempted: Int
}

type SaveBasketballBoxScoresResponse {
    basketballBoxScores: [BasketballBoxScore!]!
}

type SaveBasketballBoxScoreResponse {
    basketballBoxScore: BasketballBoxScore!
}

# ============================================================================
# Statistic Result Unions
# ============================================================================

union SaveBasketballBoxScoreResult = SaveBasketballBoxScoreResponse | GameNotFoundError | InvalidSportTypeError
union SaveBasketballBoxScoresResult = SaveBasketballBoxScoresResponse | GameNotFoundError | InvalidSportTypeError
"""
A Playground user
"""
type User implements Node {
    id: ID!
    username: String!
    firstName: String!
    lastName: String!
    displayName: String!
    player: Player
    friendship: Friendship
    """
    The user's profile picture. Null if no profile picture has been set.
    """
    profilePicture: Resource
}

"""
The current authenticated user with private fields
"""
type CurrentUser implements Node {
    id: ID!
    username: String!
    firstName: String!
    lastName: String!
    displayName: String!
    email: String!
    player: Player
    """
    The user's profile picture. Null if no profile picture has been set.
    """
    profilePicture: Resource
}

"""
Something that is related to a user
"""
interface HasUser {
    user: User!
}

"""
The Friendship status between two users
"""
enum FriendshipStatus {
    PENDING,
    ACCEPTED,
    DECLINED,
    BLOCKED
}

"""
Direction of a friendship relative to the current user
"""
enum FriendshipDirection {
    """
    Requests sent TO the current user
    """
    INCOMING
    """
    Requests sent BY the current user
    """
    OUTGOING
}

"""
The Friendship between two users
Can be bidirectional - ACCEPTED status
Can be unidirectional - PENDING status
"""
type Friendship implements Node {
    id: ID!
    requester: User!
    addressee: User!
    status: FriendshipStatus!
    createdDate: DateTime!
}

type FriendshipEdge implements Edge {
    cursor: String!
    node: Friendship!
}

type FriendshipConnection implements Connection {
    edges: [FriendshipEdge!]!
    pageInfo: PageInfo!
}

"""
Filters for querying friendships
"""
input FriendshipFilterInput {
    """
    Filter by friendship status
    """
    status: FriendshipStatus
    """
    Filter by direction relative to current user.
    INCOMING = other users requested me, OUTGOING = I requested them.
    If null, returns both directions.
    """
    direction: FriendshipDirection
}

type UserEdge implements Edge {
    cursor: String!
    node: User!
}

type UserConnection implements Connection {
    edges: [UserEdge!]!
    pageInfo: PageInfo!
}

input SendFriendRequestInput {
    userId: ID!
}

type SendFriendRequestResponse {
    friendship: Friendship!
}

input AcceptFriendRequestInput {
    requesterId: ID!
}

type AcceptFriendRequestResponse {
    friendship: Friendship!
}

input DeclineFriendRequestInput {
    requesterId: ID!
}

type DeclineFriendRequestResponse {
    friendship: Friendship!
}

input UnfriendRequestInput {
    userId: ID!
}

type UnfriendResponse {
    friendship: Friendship
}

input CancelFriendRequestInput {
    """The user to whom the pending friend request was sent."""
    addresseeId: ID!
}

type CancelFriendRequestResponse {
    friendship: Friendship!
}

input BlockUserInput {
    userId: ID!
}

type BlockUserResponse {
    friendship: Friendship!
}

input UnblockUserInput {
    userId: ID!
}

type UnblockUserResponse {
    """
    The friendship relationship after unblocking, or null if there was no
    relationship to restore (e.g., there was no prior friendship).
    """
    friendship: Friendship
}

interface Notification implements Node {
    id: ID!
    isRead: Boolean!
    createdDate: DateTime!
}

type FriendRequestReceivedNotification implements Notification & Node {
    id: ID!
    isRead: Boolean!
    createdDate: DateTime!
    """The user who sent the friend request."""
    sender: User!
}

type FriendRequestAcceptedNotification implements Notification & Node {
    id: ID!
    isRead: Boolean!
    createdDate: DateTime!
    """The user who accepted your friend request."""
    accepter: User!
}

type GameStartedNotification implements Notification & Node {
    id: ID!
    isRead: Boolean!
    createdDate: DateTime!
    """The game that started."""
    game: Game!
}

type NotificationEdge implements Edge {
    cursor: String!
    node: Notification!
}

type NotificationConnection implements Connection {
    edges: [NotificationEdge!]!
    pageInfo: PageInfo!
}

input ReadNotificationsInput {
    ids: [ID!]!
}

type ReadNotificationsResponse {
    notifications: [Notification!]!
}

type NotificationEvent {
    notification: Notification!
}

input QueryUserInput @oneOf {
    id: ID
    username: String
}

input UserSearchInput {
    query: String!
#    excludeFriends: Boolean
#    hasFriendshipStatus: FriendshipStatus
#    hasPlayer: Boolean
}

# ============================================================================
# Friendship Result Unions
# ============================================================================

union SendFriendRequestResult = SendFriendRequestResponse | UserNotFoundError | SelfActionError | FriendshipAlreadyExistsError
union AcceptFriendRequestResult = AcceptFriendRequestResponse | FriendRequestNotFoundError | InvalidFriendshipStateError
union DeclineFriendRequestResult = DeclineFriendRequestResponse | FriendRequestNotFoundError | InvalidFriendshipStateError
union UnfriendResult = UnfriendResponse | SelfActionError
union CancelFriendRequestResult = CancelFriendRequestResponse | FriendRequestNotFoundError | InvalidFriendshipStateError
union BlockUserResult = BlockUserResponse | SelfActionError | UserBlockedYouError
union UnblockUserResult = UnblockUserResponse | BlockNotFoundError | UserBlockedYouError

# ============================================================================
# Notification Result Unions
# ============================================================================

union ReadNotificationsResult = ReadNotificationsResponse | NotificationNotFoundError
