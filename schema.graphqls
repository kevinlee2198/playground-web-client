  pointsScored: Int!
}

"""
Sport-specific participant metadata. Exactly one must be provided.
Must match the game's sport type.
"""
input ParticipantMetadataInput @oneOf {
  baseball: BaseballParticipantMetadataInput
  basketball: BasketballParticipantMetadataInput
  tennis: TennisParticipantMetadataInput
  football: FootballParticipantMetadataInput
  pickleball: PickleballParticipantMetadataInput
  volleyball: VolleyballParticipantMetadataInput
}

# ============================================================================
# Create Game
# ============================================================================

"""
Sport-specific game configuration. Exactly one must be provided.
The main SportType is derived from the sport config chosen.
"""
input CreateGameInput @oneOf {
  baseball: CreateBaseballGameInput
  basketball: CreateBasketballGameInput
  football: CreateFootballGameInput
  tennis: CreateTennisGameInput
  pickleball: CreatePickleballGameInput
  volleyball: CreateVolleyballGameInput
}

"""
Create a baseball game
"""
input CreateBaseballGameInput {
  startDate: DateTime!
  description: String
  location: LocationInput
  metadata: CreateBaseballGameMetadataInput!
  """
  Defaults to PUBLIC if not provided.
  """
  visibility: GameVisibility
  """
  Defaults to OPEN if not provided.
  """
  statEntryMode: StatEntryMode
}

"""
Create a basketball game
"""
input CreateBasketballGameInput {
  startDate: DateTime!
  description: String
  location: LocationInput
  metadata: CreateBasketballGameMetadataInput!
  """
  Defaults to PUBLIC if not provided.
  """
  visibility: GameVisibility
  """
  Defaults to OPEN if not provided.
  """
  statEntryMode: StatEntryMode
}

"""
Create a football game
"""
input CreateFootballGameInput {
  startDate: DateTime!
  description: String
  location: LocationInput
  metadata: CreateFootballGameMetadataInput!
  """
  Defaults to PUBLIC if not provided.
  """
  visibility: GameVisibility
  """
  Defaults to OPEN if not provided.
  """
  statEntryMode: StatEntryMode
}

"""
Create a tennis game
"""
input CreateTennisGameInput {
  startDate: DateTime!
  description: String
  location: LocationInput
  metadata: CreateTennisGameMetadataInput!
  """
  Defaults to PUBLIC if not provided.
  """
  visibility: GameVisibility
  """
  Defaults to OPEN if not provided.
  """
  statEntryMode: StatEntryMode
}

"""
Create a pickleball game
"""
input CreatePickleballGameInput {
  startDate: DateTime!
  description: String
  location: LocationInput
  metadata: CreatePickleballGameMetadataInput!
  """
  Defaults to PUBLIC if not provided.
  """
  visibility: GameVisibility
  """
  Defaults to OPEN if not provided.
  """
  statEntryMode: StatEntryMode
}

input CreateVolleyballGameInput {
  startDate: DateTime!
  description: String
  location: LocationInput
  metadata: CreateVolleyballGameMetadataInput!
  """
  Defaults to PUBLIC if not provided.
  """
  visibility: GameVisibility
  """
  Defaults to OPEN if not provided.
  """
  statEntryMode: StatEntryMode
}

input UpdateGameInput {
  id: ID!
  description: String
  startDate: DateTime
  location: LocationInput
  """
  Sport-specific game configuration. Must match the game's sport type.
  If null will not be updated.
  """
  metadata: GameMetadataInput
  """
  If null will not be updated.
  """
  visibility: GameVisibility
  """
  If null will not be updated.
  """
  statEntryMode: StatEntryMode
}

"""
Sport-specific game configuration for updates. Exactly one must be provided.
Must match the game's sport type.
"""
input GameMetadataInput @oneOf {
  baseball: BaseballGameMetadataInput
  basketball: BasketballGameMetadataInput
  tennis: TennisGameMetadataInput
  football: FootballGameMetadataInput
  pickleball: PickleballGameMetadataInput
  volleyball: VolleyballGameMetadataInput
}

input DeleteGameInput {
  id: ID!
}

type CreateGameResponse {
  game: Game!
}

type UpdateGameResponse {
  game: Game!
}

type DeleteGameResponse implements DeleteResponse {
  id: ID!
}

"""
Start a game. If startDate is not provided defaults to current time
"""
input StartGameInput {
  id: ID!
  startDate: DateTime
}

type StartGameResponse {
  game: Game!
}

"""
End a game. If endDate is not provided defaults to current time
"""
input EndGameInput {
  id: ID!
  endDate: DateTime
}

type EndGameResponse {
  game: Game!
}

"""
Finalize game results. After finalization, only the organizer can modify scores and statistics.
The organizer can undo this with unfinalizeGameResults.
"""
input FinalizeGameResultsInput {
  id: ID!
}

type FinalizeGameResultsResponse {
  game: Game!
}

"""
Reverse finalization, allowing participants to edit scores and statistics again.
"""
input UnfinalizeGameResultsInput {
  id: ID!
}

type UnfinalizeGameResultsResponse {
  game: Game!
}

# ============================================================================
# Result Unions
# ============================================================================

union CreateGameResult = CreateGameResponse | InvalidSportConfigError
union UpdateGameResult =
  | UpdateGameResponse
  | GameNotFoundError
  | InvalidSportConfigError
  | InvalidDateRangeError
union DeleteGameResult = DeleteGameResponse | GameNotFoundError
union StartGameResult =
  | StartGameResponse
  | GameNotFoundError
  | InvalidGameStatusTransitionError
union EndGameResult =
  | EndGameResponse
  | GameNotFoundError
  | InvalidGameStatusTransitionError
union FinalizeGameResultsResult =
  | FinalizeGameResultsResponse
  | GameNotFoundError
  | InvalidGameStatusTransitionError
union UnfinalizeGameResultsResult =
  | UnfinalizeGameResultsResponse
  | GameNotFoundError
  | InvalidGameStatusTransitionError
union AddGameParticipantResult =
  | AddGameParticipantResponse
  | GameNotFoundError
  | PlayerNotFoundError
  | InvalidParticipantTypeError
union AddGameParticipantsResult =
  | AddGameParticipantsResponse
  | GameNotFoundError
  | PlayerNotFoundError
  | InvalidParticipantTypeError
union UpdateGameParticipantResult =
  | UpdateGameParticipantResponse
  | GameNotFoundError
  | ParticipantNotFoundError
union UpdateGameParticipantsResult =
  | UpdateGameParticipantsResponse
  | GameNotFoundError
  | ParticipantNotFoundError
union RemoveGameParticipantResult =
  | RemoveGameParticipantResponse
  | GameNotFoundError
  | ParticipantNotFoundError
union RemoveGameParticipantsResult =
  | RemoveGameParticipantsResponse
  | GameNotFoundError
  | ParticipantNotFoundError
union AddPlayerToTeamInstanceResult =
  | AddPlayerToTeamInstanceResponse
  | TeamInstanceNotFoundError
  | PlayerNotFoundError
union AddPlayersToTeamInstanceResult =
  | AddPlayersToTeamInstanceResponse
  | TeamInstanceNotFoundError
  | PlayerNotFoundError
union RemovePlayerFromTeamInstanceResult =
  | RemovePlayerFromTeamInstanceResponse
  | TeamInstanceNotFoundError
  | PlayerNotFoundError
union RemovePlayersFromTeamInstanceResult =
  | RemovePlayersFromTeamInstanceResponse
  | TeamInstanceNotFoundError
  | PlayerNotFoundError

# ============================================================================
# Game Editor Management
# ============================================================================

"""
Add a user as an editor to a game.
"""
input AddGameEditorInput {
  gameId: ID!
  userId: ID!
}

type AddGameEditorResponse {
  gameMember: GameMember!
}

"""
Remove an editor from a game.
"""
input RemoveGameEditorInput {
  gameId: ID!
  userId: ID!
}

type RemoveGameEditorResponse {
  id: ID!
}

"""
Transfer game ownership to another user.
The current owner becomes an editor.
"""
input TransferGameOwnershipInput {
  gameId: ID!
  userId: ID!
}

type TransferGameOwnershipResponse {
  gameMember: GameMember!
}

union AddGameEditorResult =
  | AddGameEditorResponse
  | GameNotFoundError
  | UserNotFoundError
union RemoveGameEditorResult =
  | RemoveGameEditorResponse
  | GameNotFoundError
  | UserNotFoundError
union TransferGameOwnershipResult =
  | TransferGameOwnershipResponse
  | GameNotFoundError
  | UserNotFoundError

# ============================================================================
# Game Subscription Events
# ============================================================================

interface GameEvent {
  """
  The game this event belongs to.
  """
  game: Game!
  """
  When the event occurred.
  """
  occurredAt: DateTime!
}

# --- Status events ---

type GameStartedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
}

type GameEndedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
}

type GameResultsFinalizedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
}

type GameResultsUnfinalizedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
}

# --- Score events ---

"""
Emitted when a participant's score/metadata is updated.
"""
type GameScoreUpdatedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
  """
  The participant whose score changed.
  """
  participant: GameParticipant!
}

# --- Participant events ---

type GameParticipantAddedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
  participant: GameParticipant!
}

type GameParticipantRemovedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
  """
  The ID of the removed participant.
  """
  participantId: ID!
}

# --- Roster events ---

type TeamRosterUpdatedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
  """
  The team instance whose roster changed.
  """
  teamInstance: TeamInstance!
}

# --- Basketball stats events ---

type BasketballStatsSavedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
  basketballStats: [BasketballStats!]!
}

# ============================================================================
# Game Invitations
# ============================================================================

enum GameInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

type GameInvitation implements Node {
  id: ID!
  game: Game!
  """
  The user who sent the invitation.
  """
  inviter: User!
  """
  The user being invited.
  """
  invitee: User!
  status: GameInvitationStatus!
  """
  When the invitation was accepted. Null if not yet accepted.
  """
  acceptedDate: DateTime
  createdDate: DateTime!
}

type GameInvitationEdge implements Edge {
  cursor: String!
  node: GameInvitation!
}

type GameInvitationConnection implements Connection {
  edges: [GameInvitationEdge!]!
  pageInfo: PageInfo!
}

# --- Invitation Mutations ---

input SendGameInvitationInput {
  gameId: ID!
  userId: ID!
}

input SendGameInvitationsInput {
  gameId: ID!
  userIds: [ID!]!
}

input AcceptGameInvitationInput {
  invitationId: ID!
}

input DeclineGameInvitationInput {
  invitationId: ID!
}

input CancelGameInvitationInput {
  invitationId: ID!
}

type SendGameInvitationResponse {
  """
  Null when the invitation was silently skipped (self-invite or invitee is already a manager).
  """
  invitation: GameInvitation
}

"""
Per-invitee result for bulk invitation sending.
"""
type SendGameInvitationItemResult {
  """
  The user ID this result corresponds to.
  """
  userId: ID!
  """
  The created/updated invitation, if successful.
  """
  invitation: GameInvitation
  """
  The error, if this invitee could not be invited.
  """
  error: Error
}

type SendGameInvitationsResponse {
  results: [SendGameInvitationItemResult!]!
}

type AcceptGameInvitationResponse {
  invitation: GameInvitation!
}

type DeclineGameInvitationResponse {
  """
  The ID of the deleted invitation.
  """
  id: ID!
}

type CancelGameInvitationResponse {
  invitation: GameInvitation!
}

# --- Invitation Errors ---
# Note: UserBlockedError already exists in errors.graphqls and is reused here.

type AlreadyInvitedError implements Error {
  message: String!
}

type AlreadyParticipantError implements Error {
  message: String!
}

type InvitationNotFoundError implements Error {
  message: String!
}

type InvalidInvitationStatusError implements Error {
  message: String!
}

type GameCompleteError implements Error {
  message: String!
}

# --- Invitation Result Unions ---

union SendGameInvitationResult =
  | SendGameInvitationResponse
  | GameNotFoundError
  | UserNotFoundError
  | AlreadyInvitedError
  | AlreadyParticipantError
  | UserBlockedError
  | GameCompleteError
union SendGameInvitationsResult =
  | SendGameInvitationsResponse
  | GameNotFoundError
  | GameCompleteError
union AcceptGameInvitationResult =
  | AcceptGameInvitationResponse
  | InvitationNotFoundError
  | InvalidInvitationStatusError
union DeclineGameInvitationResult =
  | DeclineGameInvitationResponse
  | InvitationNotFoundError
  | InvalidInvitationStatusError
union CancelGameInvitationResult =
  | CancelGameInvitationResponse
  | InvitationNotFoundError
  | InvalidInvitationStatusError
"""
A player in a game. Persists across games.
Physical attributes (age, height, weight) may be null if the viewer has
a blocking relationship with this player's user.
"""
type Player implements Node {
  id: ID!
  """
  Null when the viewer has a blocking relationship with this player's user.
  """
  age: Int
  """
  Null when the viewer has a blocking relationship with this player's user.
  """
  height: Float
  """
  Null when the viewer has a blocking relationship with this player's user.
  """
  weight: Float
  """
  Null when the viewer has a blocking relationship with this player's user.
  """
  user: User
}

"""
Updates the current user's player profile.
Omit a field to leave it unchanged. Setting a field to null will clear it.
"""
input UpdatePlayerInput {
  age: Int
  height: Float
  weight: Float
}

type UpdatePlayerResponse {
  player: Player!
}

union UpdatePlayerResult = UpdatePlayerResponse
# ============================================================================
# Resource / File Management (v2)
#
# Resources are files (images, documents, videos) stored in S3.
# Clients interact with resources through fields on parent types
# (User.profilePicture, Game.media, MediaChatMessage.resource)
# rather than through generic polymorphic queries.
#
# Backend-only concerns (ownerType, storageType, resourceStatus) are not
# exposed in the public schema.
# ============================================================================

# ============================================================================
# Resource Types
# ============================================================================

"""
A stored file. Concrete types carry format-specific metadata.
"""
interface Resource implements Node {
  id: ID!
  filename: String!
  """
  File size in bytes.
  """
  size: Long!
  mimeType: String!
  """
  Presigned download URL. Ephemeral — generated on demand by the resolver.
  """
  downloadUrl: String!
  createdDate: DateTime!
}

"""
An image resource with dimension and thumbnail metadata.
Dimensions and thumbnail are extracted server-side after upload and may
not be immediately available (null until processing completes).
"""
type ImageResource implements Resource & Node {
  id: ID!
  filename: String!
  size: Long!
  mimeType: String!
  downloadUrl: String!
  createdDate: DateTime!
  width: Int
  height: Int
  """
  Presigned URL for a smaller thumbnail variant.
  Null if no thumbnail has been generated yet.
  """
  thumbnailUrl: String
}

"""
A generic file resource (documents, etc.).
"""
type FileResource implements Resource & Node {
  id: ID!
  filename: String!
  size: Long!
  mimeType: String!
  downloadUrl: String!
  createdDate: DateTime!
}

type ResourceEdge implements Edge {
  cursor: String!
  node: Resource!
}

type ResourceConnection implements Connection {
  edges: [ResourceEdge!]!
  pageInfo: PageInfo!
}

# ============================================================================
# Upload Flow — Phase 1: Request Upload
#
# Client calls requestUpload with file metadata and an upload context
# that identifies what entity the resource will be attached to.
# Server returns a presigned PUT URL for the client to upload directly to S3.
# ============================================================================

"""
Identifies what entity the resource will be attached to.
Enables per-context server-side validation (e.g., profile pictures must be images).
"""
input UploadContextInput @oneOf {
  """
  Upload a profile picture for the current user.
  """
  userProfilePicture: UserProfilePictureUploadContext
  """
  Upload media (photo/video) to a game.
  """
  gameMedia: GameMediaUploadContext
  """
  Upload a file/image to a chat room. The resource is linked to the
  chat message when sendChatMessage is called with the resourceId.
  For chat media, sendChatMessage is the confirmation step — do NOT
  call confirmUpload separately.
  """
  chatMedia: ChatMediaUploadContext
}

input UserProfilePictureUploadContext {
  """
  If true, this is a placeholder upload (no resize support yet).
  """
  placeholder: Boolean
}

input GameMediaUploadContext {
  gameId: ID!
}

input ChatMediaUploadContext {
  chatRoomId: ID!
}

input RequestUploadInput {
  filename: String!
  mimeType: String!
  size: Long!
  context: UploadContextInput!
}

type RequestUploadResponse {
  """
  Presigned PUT URL. Client uploads file bytes directly to this URL.
  Null when using LOCAL storage (dev environments only).
  """
  uploadUrl: String
  """
  Resource ID. Use this to confirm the upload (phase 2) or to
  reference the resource when sending a chat message.
  """
  resourceId: ID!
}

# ============================================================================
# Upload Flow — Phase 2: Confirm Upload
#
# After the client uploads the file to S3, it calls confirmUpload
# to transition the resource from REQUESTED to PERMANENT.
#
# Exception: chat media resources are confirmed automatically when
# sendChatMessage is called — no separate confirmUpload needed.
# ============================================================================

input ConfirmUploadInput {
  resourceId: ID!
}

type ConfirmUploadResponse {
  resource: Resource!
}

# ============================================================================
# Delete Resource
# ============================================================================

input DeleteResourceInput {
  resourceId: ID!
}

type DeleteResourceResponse implements DeleteResponse {
  id: ID!
}

# ============================================================================
# Resource Result Unions
# ============================================================================

union RequestUploadResult = RequestUploadResponse | InvalidUploadContextError
union ConfirmUploadResult = ConfirmUploadResponse | ResourceNotFoundError
union DeleteResourceResult = DeleteResourceResponse | ResourceNotFoundError
scalar DateTime
scalar JSON
"""
A 64-bit signed integer. Represents values from -(2^63) to 2^63-1.
Serialized as a JSON number when within safe integer range, otherwise as a string.
"""
scalar Long

"""
The direction to sort results
"""
enum SortDirection {
  ASC
  DESC
}

"""
Node IDs are unique only within a type
"""
interface Node {
  id: ID!
}

interface Edge {
  cursor: String!
  node: Node!
}

interface Connection {
  edges: [Edge!]!
  pageInfo: PageInfo!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

interface DeleteResponse {
  id: ID!
}

interface HasLocation {
  location: Location
}

type Location implements Node {
  id: ID!
  name: String
  address: Address!
  coordinates: Coordinates
}

type Address {
  street: String
  city: String!
  state: String
  postalCode: String
  country: String!
}

type Coordinates {
  latitude: Float!
  longitude: Float!
}

input LocationInput {
  name: String
  address: AddressInput!
  coordinates: CoordinatesInput
}

input AddressInput {
  street: String
  city: String!
  state: String
  postalCode: String
  country: String!
}

input CoordinatesInput {
  latitude: Float!
  longitude: Float!
}

type Query {
  """
  Get a user by ID or username
  """
  user(input: QueryUserInput!): User
  """
  Get the user info for the current logged-in user.
  Returns additional private fields like email.
  """
  me: CurrentUser!
  """
  Search for users by name.
  """
  searchUsers(
    input: UserSearchInput!
    first: Int
    after: String
    last: Int
    before: String
  ): UserConnection!
  """
  Get mutual follows for the current user (paginated).
  Users where both parties follow each other.
  For the chat "new conversation" selector.
  User must be authenticated.
  """
  mutualFollows(
    first: Int
    after: String
    last: Int
    before: String
  ): UserConnection!
  """
  Get users the current user has blocked (paginated).
  Only returns users that the caller has blocked (not users who have blocked the caller).
  User must be authenticated.
  """
  blockedUsers(
    first: Int
    after: String
    last: Int
    before: String
  ): UserConnection!
  """
  Activity feed showing games from people the current user follows.
  Ordered by start date DESC (most recent first).
  User must be authenticated.
  """
  followingActivityFeed(
    first: Int
    after: String
    last: Int
    before: String
  ): GameConnection!
  """
  Get a player by ID
  """
  player(id: ID!): Player
  """
  Get a game by ID
  """
  game(id: ID!): Game
  """
  Query and filter games
  Filters are AND-ed together
  Sort entries are sorted in-order of the list
  """
  games(
    input: GameFilterInput!
    sort: [GameSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): GameConnection!
  """
  Query for notifications for the current user.
  Ordered by createdDate DESC (most recent first).
  Use `first` to fetch the most recent notifications; `after` to load older notifications.
  User must be authenticated.
  """
  notifications(
    first: Int
    after: String
    last: Int
    before: String
  ): NotificationConnection!
  """
  Get follow requests for the current user.
  INCOMING: requests others have sent to you. OUTGOING: requests you have sent.
  Ordered by createdDate DESC. Use first/after.
  """
  followRequests(
    direction: FollowRequestDirection!
    first: Int
    after: String
    last: Int
    before: String
  ): FollowRequestConnection!
  """
  Get a chat room
  User must be authenticated.
  """
  chatRoom(id: ID!): ChatRoom
  """
  Query for chat rooms for the current user.
  Ordered by lastModifiedDate DESC (most recently active first).
  Use `first` to fetch the most recently active rooms; `after` to load older rooms.
  User must be authenticated.
  """
  chatRooms(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomConnection!
  """
  Find the direct message chat room between the current user and another user.
  Returns null if no DM exists.
  """
  directMessageChatRoom(userId: ID!): ChatRoom
  """
  Query and filter basketball stats
  """
  basketballStats(
    input: BasketballStatsFilterInput!
    sort: [BasketballStatsSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): BasketballStatsConnection!
  """
  Query and filter football offensive stats
  """
  footballOffensiveStats(
    input: FootballOffensiveStatsFilterInput!
    sort: [FootballOffensiveStatsSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): FootballOffensiveStatsConnection!
  """
  Query and filter football defensive stats
  """
  footballDefensiveStats(
    input: FootballDefensiveStatsFilterInput!
    sort: [FootballDefensiveStatsSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): FootballDefensiveStatsConnection!
  """
  Query and filter football special teams stats
  """
  footballSpecialTeamsStats(
    input: FootballSpecialTeamsStatsFilterInput!
    sort: [FootballSpecialTeamsStatsSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): FootballSpecialTeamsStatsConnection!
  """
  Query and filter pickleball stats
  """
  pickleballStats(
    input: PickleballStatsFilterInput!
    sort: [PickleballStatsSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): PickleballStatsConnection!
  """
  Query and filter tennis match stats
  """
  tennisStats(
    input: TennisStatsFilterInput!
    sort: [TennisStatsSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): TennisStatsConnection!
  """
  Query and filter baseball batting stats
  """
  baseballBattingStats(
    input: BaseballBattingStatsFilterInput!
    sort: [BaseballBattingStatsSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): BaseballBattingStatsConnection!
  """
  Query and filter baseball pitching stats
  """
  baseballPitchingStats(
    input: BaseballPitchingStatsFilterInput!
    sort: [BaseballPitchingStatsSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): BaseballPitchingStatsConnection!
  """
  Query and filter baseball fielding stats
  """
  baseballFieldingStats(
    input: BaseballFieldingStatsFilterInput!
    sort: [BaseballFieldingStatsSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): BaseballFieldingStatsConnection!
  """
  Query and filter volleyball stats
  """
  volleyballStats(
    input: VolleyballStatsFilterInput!
    sort: [VolleyballStatsSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): VolleyballStatsConnection!
  """
  Resolve a URL to detect its media type, fetch oEmbed/OpenGraph metadata,
  and check for duplicates. Phase 1 of the Add Link flow.
  The caller must have a role on the game (participant, editor, or owner).
  """
  resolveUrl(input: ResolveUrlInput!): ResolveUrlResult!
}

"""
Unless otherwise specified users must be authenticated before calling a mutation
When performing an update, only fields specified in the input will be updated
"""
type Mutation {
  """
  Update the current user's profile.
  """
  updateUser(input: UpdateUserInput!): UpdateUserResult!
  """
  Update the current user's player profile.
  """
  updatePlayer(input: UpdatePlayerInput!): UpdatePlayerResult!
  """
  Create a game.
  """
  createGame(input: CreateGameInput!): CreateGameResult!
  """
  Update a game.
  """
  updateGame(input: UpdateGameInput!): UpdateGameResult!
  """
  Delete a game.
  """
  deleteGame(input: DeleteGameInput!): DeleteGameResult!
  """
  Add a participant to a game.
  Use teamInstance for team sports, individual for individual competition formats.
  """
  addGameParticipant(input: AddGameParticipantInput!): AddGameParticipantResult!
  """
  Add multiple participants to a game.
  """
  addGameParticipants(
    input: AddGameParticipantsInput!
  ): AddGameParticipantsResult!
  """
  Update a participant in a game.
  Currently only team instances have updatable fields.
  """
  updateGameParticipant(
    input: UpdateGameParticipantInput!
  ): UpdateGameParticipantResult!
  """
  Update multiple participants in a game.
  """
  updateGameParticipants(
    input: UpdateGameParticipantsInput!
  ): UpdateGameParticipantsResult!
  """
  Remove a participant from a game.
  """
  removeGameParticipant(
    input: RemoveGameParticipantInput!
  ): RemoveGameParticipantResult!
  """
  Remove multiple participants from a game.
  """
  removeGameParticipants(
    input: RemoveGameParticipantsInput!
  ): RemoveGameParticipantsResult!
  """
  Add a player to an existing team instance.
  """
  addPlayerToTeamInstance(
    input: AddPlayerToTeamInstanceInput!
  ): AddPlayerToTeamInstanceResult!
  """
  Add multiple players to an existing team instance.
  """
  addPlayersToTeamInstance(
    input: AddPlayersToTeamInstanceInput!
  ): AddPlayersToTeamInstanceResult!
  """
  Remove a player from a team instance.
  """
  removePlayerFromTeamInstance(
    input: RemovePlayerFromTeamInstanceInput!
  ): RemovePlayerFromTeamInstanceResult!
  """
  Remove multiple players from a team instance.
  """
  removePlayersFromTeamInstance(
    input: RemovePlayersFromTeamInstanceInput!
  ): RemovePlayersFromTeamInstanceResult!
  """
  Start a game.
  Enables saving of statistics to the game.
  """
  startGame(input: StartGameInput!): StartGameResult!
  """
  End a game.
  """
  endGame(input: EndGameInput!): EndGameResult!
  """
  Finalize the game. Transitions status from COMPLETE to FINALIZED.
  When finalized, all scores, statistics, rosters, and participants are locked.
  Only the organizer (owner/editor) can modify data while finalized.
  """
  finalizeGameResults(
    input: FinalizeGameResultsInput!
  ): FinalizeGameResultsResult!
  """
  Reverse finalization. Transitions status from FINALIZED back to COMPLETE,
  allowing participants to edit scores and statistics again.
  """
  unfinalizeGameResults(
    input: UnfinalizeGameResultsInput!
  ): UnfinalizeGameResultsResult!
  """
  Add a user as an editor to a game. Only the game owner can do this.
  """
  addGameEditor(input: AddGameEditorInput!): AddGameEditorResult!
  """
  Remove an editor from a game. Only the game owner can do this.
  """
  removeGameEditor(input: RemoveGameEditorInput!): RemoveGameEditorResult!
  """
  Transfer game ownership to another user. The current owner becomes an editor.
  Only the game owner can do this.
  """
  transferGameOwnership(
    input: TransferGameOwnershipInput!
  ): TransferGameOwnershipResult!
  """
  Start a livestream on a game. Creates a LivestreamMedia item.
  """
  startLivestream(input: StartLivestreamInput!): StartLivestreamResult!
  """
  End a livestream on a game. Transitions LivestreamMedia to VideoMedia.
  """
  endLivestream(input: EndLivestreamInput!): EndLivestreamResult!
  """
  Update a livestream's title or description. Only the streamer can do this.
  """
  updateLivestream(input: UpdateLivestreamInput!): UpdateLivestreamResult!
  """
  Add an external link (URL) as a GameMedia item to a game.
  Phase 2 of the Add Link flow -- call resolveUrl first to obtain the preview.
  """
  addGameMediaLink(input: AddGameMediaLinkInput!): AddGameMediaLinkResult!
  """
  Delete a GameMedia item. For uploads, also deletes the backing Resource and S3 object.
  """
  deleteGameMedia(input: DeleteGameMediaInput!): DeleteGameMediaResult!
  """
  Send a heartbeat for an active livestream to keep it alive.
  Missed heartbeats trigger auto-transition to VideoMedia.
  """
  livestreamHeartbeat(
    input: LivestreamHeartbeatInput!
  ): LivestreamHeartbeatResult!
  """
  Follow a user. Idempotent.
  """
  followUser(input: FollowUserInput!): FollowUserResult!
  """
  Unfollow a user.
  """
  unfollowUser(input: UnfollowUserInput!): UnfollowUserResult!
  """
  Remove a user from your followers list without blocking them.
  """
  removeFollower(input: RemoveFollowerInput!): RemoveFollowerResult!
  """
  Block a user. Removes any existing follow relationships in both directions.
  """
  blockUser(input: BlockUserInput!): BlockUserResult!
  """
  Unblock a user you previously blocked.
  """
  unblockUser(input: UnblockUserInput!): UnblockUserResult!
  """
  Approve a follow request. Only the target can approve.
  """
  approveFollowRequest(
    input: ApproveFollowRequestInput!
  ): ApproveFollowRequestResult!
  """
  Decline a follow request. Only the target can decline. Silent — no notification sent.
  """
  declineFollowRequest(
    input: DeclineFollowRequestInput!
  ): DeclineFollowRequestResult!
  """
  Cancel an outgoing follow request. Only the requester can cancel.
  """
  cancelFollowRequest(
    input: CancelFollowRequestInput!
  ): CancelFollowRequestResult!
  """
  Read notifications for the current user
  """
  readNotifications(input: ReadNotificationsInput!): ReadNotificationsResult!
  """
  Create a direct message conversation with another user.
  Idempotent: returns the existing DM if one already exists.
  """
  createDirectMessage(
    input: CreateDirectMessageInput!
  ): CreateDirectMessageResult!
  """
  Create a group chat with multiple users.
  """
  createGroupChat(input: CreateGroupChatInput!): CreateGroupChatResult!
  """
  Add a user to the chat room
  """
  addChatRoomMember(input: AddChatRoomMemberInput!): AddChatRoomMemberResult!
  """
  Remove a user from the chat room
  """
  removeChatRoomMember(
    input: RemoveChatRoomMemberInput!
  ): RemoveChatRoomMemberResult!
  """
  Rename a group chat room. Only the Owner or Admin may rename.
  """
  renameChatRoom(input: RenameChatRoomInput!): RenameChatRoomResult!
  """
  Update a chat room member's role. Covers promote (MEMBER→ADMIN), demote (ADMIN→MEMBER),
  and ownership transfer (X→OWNER, which also demotes the current Owner to MEMBER).
  Only the Owner can change roles. Not applicable to direct message chat rooms.
  """
  updateChatRoomMemberRole(
    input: UpdateChatRoomMemberRoleInput!
  ): UpdateChatRoomMemberRoleResult!
  """
  Leave a group chat room. The Owner must transfer ownership before leaving.
  """
  leaveChatRoom(input: LeaveChatRoomInput!): LeaveChatRoomResult!
  """
  Send a chat message
  """
  sendChatMessage(input: SendChatMessageInput!): SendChatMessageResult!
  """
  Update a chat message
  """
  updateChatMessage(input: UpdateChatMessageInput!): UpdateChatMessageResult!
  """
  Delete a message
  """
  deleteChatMessage(input: DeleteChatMessageInput!): DeleteChatMessageResult!
  """
  Save stats for a basketball game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveBasketballStats(
    input: SaveBasketballStatsInput!
  ): SaveBasketballStatsResult!
  """
  Save stats for multiple players in a basketball game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveBasketballStatsBulk(
    input: SaveBasketballStatsBulkInput!
  ): SaveBasketballStatsBulkResult!
  """
  Save offensive stats for a football game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveFootballOffensiveStats(
    input: SaveFootballOffensiveStatsInput!
  ): SaveFootballOffensiveStatsResult!
  """
  Save offensive stats for multiple players in a football game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveFootballOffensiveStatsBulk(
    input: SaveFootballOffensiveStatsBulkInput!
  ): SaveFootballOffensiveStatsBulkResult!
  """
  Save defensive stats for a football game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveFootballDefensiveStats(
    input: SaveFootballDefensiveStatsInput!
  ): SaveFootballDefensiveStatsResult!
  """
  Save defensive stats for multiple players in a football game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveFootballDefensiveStatsBulk(
    input: SaveFootballDefensiveStatsBulkInput!
  ): SaveFootballDefensiveStatsBulkResult!
  """
  Save special teams stats for a football game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveFootballSpecialTeamsStats(
    input: SaveFootballSpecialTeamsStatsInput!
  ): SaveFootballSpecialTeamsStatsResult!
  """
  Save special teams stats for multiple players in a football game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveFootballSpecialTeamsStatsBulk(
    input: SaveFootballSpecialTeamsStatsBulkInput!
  ): SaveFootballSpecialTeamsStatsBulkResult!
  """
