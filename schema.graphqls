}

input SendTextChatMessageInput {
  chatRoomId: ID!
  content: String!
  replyToId: ID
}

"""
Send a media message. The resourceId must reference a resource that was
uploaded via requestUpload with a chatMedia context.
Sending the message also confirms the resource (transitions it to PERMANENT) —
do NOT call confirmUpload separately for chat media.
"""
input SendMediaChatMessageInput {
  chatRoomId: ID!
  """
  The resource ID returned from requestUpload.
  """
  resourceId: ID!
  caption: String
  replyToId: ID
}

"""
Polymorphic input for sending different types of chat messages.
Exactly one field must be provided.
"""
input SendChatMessageInput @oneOf {
  textMessage: SendTextChatMessageInput
  mediaMessage: SendMediaChatMessageInput
}

input UpdateTextChatMessageInput {
  id: ID!
  content: String!
}

"""
Polymorphic input for updating different types of chat messages.
Exactly one field must be provided.
"""
input UpdateChatMessageInput @oneOf {
  textMessage: UpdateTextChatMessageInput
}

type UpdateChatMessageResponse {
  chatMessage: ChatMessage!
}

input DeleteChatMessageInput {
  id: ID!
}

type DeleteChatMessageResponse implements DeleteResponse {
  id: ID!
}

