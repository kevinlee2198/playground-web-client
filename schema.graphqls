  playerId: ID!
  defensiveRebounds: Int
  offensiveRebounds: Int
  assists: Int
  steals: Int
  blocks: Int
  turnovers: Int
  personalFouls: Int
  threePointersMade: Int
  threePointersAttempted: Int
  twoPointersMade: Int
  twoPointersAttempted: Int
  freeThrowsMade: Int
  freeThrowsAttempted: Int
}

input SaveBasketballBoxScoreInput {
  playerId: ID!
  gameId: ID!
  defensiveRebounds: Int
  offensiveRebounds: Int
  assists: Int
  steals: Int
  blocks: Int
  turnovers: Int
  personalFouls: Int
  threePointersMade: Int
  threePointersAttempted: Int
  twoPointersMade: Int
  twoPointersAttempted: Int
  freeThrowsMade: Int
  freeThrowsAttempted: Int
}

type SaveBasketballBoxScoresResponse {
