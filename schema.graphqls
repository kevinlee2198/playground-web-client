  | InvalidSportTypeError
union SaveVolleyballStatsBulkResult =
  | SaveVolleyballStatsBulkResponse
  | GameNotFoundError
  | InvalidSportTypeError
enum MeasurementUnit {
  METRIC
  IMPERIAL
}

enum EmailDigestFrequency {
  DAILY
  WEEKLY
  NEVER
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

type UserPreferences implements Node {
  id: ID!
  measurementUnit: MeasurementUnit!
  notificationsEnabled: Boolean!
  emailDigestFrequency: EmailDigestFrequency!
  profileVisibility: ProfileVisibility!
  showOnlineStatus: Boolean!
  showGameHistory: Boolean!
  showStatistics: Boolean!
  preferredSports: [SportType!]!
}

input UpdateUserPreferencesInput {
  measurementUnit: MeasurementUnit
  notificationsEnabled: Boolean
  emailDigestFrequency: EmailDigestFrequency
  profileVisibility: ProfileVisibility
  showOnlineStatus: Boolean
  showGameHistory: Boolean
  showStatistics: Boolean
  preferredSports: [SportType!]
}

type UpdateUserPreferencesResponse {
  preferences: UserPreferences!
}

union UpdateUserPreferencesResult = UpdateUserPreferencesResponse

extend type CurrentUser {
  preferences: UserPreferences!
}

extend type Mutation {
  """
  Update the current user's account preferences. Only provided fields are changed.
  """
  updateUserPreferences(
    input: UpdateUserPreferencesInput!
  ): UpdateUserPreferencesResult!
}
"""
A Playground user
"""
type User implements Node {
  id: ID!
  username: String!
  """
  Null when the profile is private and viewer is not a follower.
  """
  firstName: String
  """
  Null when the profile is private and viewer is not a follower.
  """
  lastName: String
  displayName: String!
  """
  The user's profile visibility setting.
  """
  profileVisibility: ProfileVisibility!
  biography: String
  player: Player!
  """
  Whether the authenticated viewer follows this user.
  Null when unauthenticated.
  """
  viewerFollowsUser: Boolean
  """
  Whether this user follows the authenticated viewer.
  Null when unauthenticated.
  """
  userFollowsViewer: Boolean
  """
  The viewer's outgoing follow request to this user, if any.
  Null when no outgoing request exists or the viewer is unauthenticated.
  """
  viewerSentFollowRequest: FollowRequest
  """
  This user's incoming follow request to the viewer, if any.
  Null when no incoming request exists or the viewer is unauthenticated.
  """
  viewerReceivedFollowRequest: FollowRequest
  """
  Number of users who follow this user.
  """
  followerCount: Int!
  """
  Number of users this user follows.
  """
  followingCount: Int!
  """
  The user's profile picture. Null if no profile picture has been set.
  """
  profilePicture: Resource
  """
  Users who follow this user (paginated).
  Ordered by follow date DESC (most recent followers first).
  """
  followers(
    first: Int
    after: String
    last: Int
    before: String
  ): FollowConnection!
  """
  Users this user follows (paginated).
  Ordered by follow date DESC (most recently followed first).
  """
  following(
    first: Int
    after: String
    last: Int
    before: String
  ): FollowConnection!
}

"""
The current authenticated user with private fields
"""
type CurrentUser implements Node {
  id: ID!
  username: String!
  firstName: String!
  lastName: String!
  displayName: String!
  biography: String
  email: String!
  player: Player!
  """
  The user's profile picture. Null if no profile picture has been set.
  """
  profilePicture: Resource
  """
  Number of users who follow the current user.
  """
  followerCount: Int!
  """
  Number of users the current user follows.
  """
  followingCount: Int!
  """
  The current user's profile visibility setting.
  """
  profileVisibility: ProfileVisibility!
}

"""
Something that is related to a user
"""
interface HasUser {
  user: User!
}

"""
A follow relationship. The follower follows the following user.
"""
type Follow implements Node {
  id: ID!
  """
  The user who is performing the follow action.
  """
  follower: User!
  """
  The user being followed.
  """
  following: User!
  createdDate: DateTime!
}

type FollowEdge implements Edge {
  cursor: String!
  node: Follow!
}

type FollowConnection implements Connection {
  edges: [FollowEdge!]!
  pageInfo: PageInfo!
}

type UserEdge implements Edge {
  cursor: String!
  node: User!
}

type UserConnection implements Connection {
  edges: [UserEdge!]!
  pageInfo: PageInfo!
}

input FollowUserInput {
  userId: ID!
}

input UnfollowUserInput {
  userId: ID!
}

input RemoveFollowerInput {
  userId: ID!
}

type FollowUserResponse {
  """
  The followed user with updated counts and follow state.
  """
  user: User!
}

type UnfollowUserResponse {
  """
  The unfollowed user with updated counts and follow state.
  """
  user: User!
  """
  Whether the unfollow broke a mutual follow (the other user still follows the caller).
  """
  wasMutualFollow: Boolean!
}

type RemoveFollowerResponse {
  """
  The ID of the removed follower.
  """
  userId: ID!
}

input BlockUserInput {
  userId: ID!
}

type BlockUserResponse {
  """
  The ID of the blocked user.
  """
  userId: ID!
}

input UnblockUserInput {
  userId: ID!
}

type UnblockUserResponse {
  """
  The ID of the unblocked user.
  """
  userId: ID!
}

interface Notification implements Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
}

type NewFollowerNotification implements Notification & Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
  """
  The user who started following you.
  """
  follower: User!
}

type GameStartedNotification implements Notification & Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
  """
  The game that started.
  """
  game: Game!
}

type GameInvitationReceivedNotification implements Notification & Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
  """
  The user who sent the invitation.
  """
  inviter: User!
  """
  The game the invitation is for.
  """
  game: Game!
  """
  The invitation itself. Null if the invitation was declined (deleted) after the notification was created.
  """
  invitation: GameInvitation
}

type FollowRequestReceivedNotification implements Notification & Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
  """
  The user who sent you a follow request.
  """
  requester: User!
  """
  The follow request. Null if the request was already approved, declined, or cancelled.
  """
  followRequest: FollowRequest
}

type FollowRequestApprovedNotification implements Notification & Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
  """
  The user who approved your follow request.
  """
  approver: User!
}

type NotificationEdge implements Edge {
  cursor: String!
  node: Notification!
}

type NotificationConnection implements Connection {
  edges: [NotificationEdge!]!
  pageInfo: PageInfo!
}

input ReadNotificationsInput {
  ids: [ID!]!
}

type ReadNotificationsResponse {
  notifications: [Notification!]!
}

type NotificationEvent {
  notification: Notification!
}

input QueryUserInput @oneOf {
  id: ID
  username: String
}

input UserSearchInput {
  query: String!
}

"""
Update the current user's profile fields.
Fields not specified will not be updated.
"""
input UpdateUserInput {
  """
  Omit to leave unchanged. Setting to null will clear the biography.
  """
  biography: String
  """
  Omit to leave unchanged. Cannot be set to null.
  """
  displayName: String
}

type UpdateUserResponse {
  user: CurrentUser!
}

union UpdateUserResult = UpdateUserResponse

# ============================================================================
# Follow Result Unions
# ============================================================================

union FollowUserResult =
  | FollowUserResponse
  | FollowRequestSentResponse
  | FollowRequestAlreadyExistsError
  | UserNotFoundError
  | SelfActionError
  | UserBlockedError
union UnfollowUserResult =
  | UnfollowUserResponse
  | SelfActionError
  | UserNotFoundError
union RemoveFollowerResult = RemoveFollowerResponse | SelfActionError
union BlockUserResult = BlockUserResponse | SelfActionError | UserNotFoundError
union UnblockUserResult = UnblockUserResponse | BlockNotFoundError

# ============================================================================
# Notification Result Unions
# ============================================================================

union ReadNotificationsResult =
  | ReadNotificationsResponse
  | NotificationNotFoundError
