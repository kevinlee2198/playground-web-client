input SaveBaseballBattingStatsData {
  playerId: ID!
  atBats: Int
  runs: Int
  hits: Int
  doubles: Int
  triples: Int
  homeRuns: Int
  rbi: Int
  walks: Int
  strikeouts: Int
  stolenBases: Int
  caughtStealing: Int
  hitByPitch: Int
  sacrifices: Int
}

input SaveBaseballBattingStatsBulkInput {
  gameId: ID!
  battingStats: [SaveBaseballBattingStatsData!]!
}

type SaveBaseballBattingStatsResponse {
  baseballBattingStats: BaseballBattingStats!
}

type SaveBaseballBattingStatsBulkResponse {
  battingStats: [BaseballBattingStats!]!
}

union SaveBaseballBattingStatsResult =
  | SaveBaseballBattingStatsResponse
  | GameNotFoundError
  | InvalidSportTypeError
union SaveBaseballBattingStatsBulkResult =
  | SaveBaseballBattingStatsBulkResponse
  | GameNotFoundError
  | InvalidSportTypeError

# ============================================================================
# Baseball Pitching Stats
# ============================================================================

"""
Filter for baseball pitching stats by game and/or player.
At least one of gameIds or playerIds must be provided.
"""
input BaseballPitchingStatsFilterInput {
  gameIds: [ID!]
  playerIds: [ID!]
}

"""
Baseball pitching statistics for a single player in a game.
inningsPitched uses standard baseball notation: 6.1 = 6⅓ innings, 6.2 = 6⅔ innings.
"""
type BaseballPitchingStats implements Node {
  id: ID!
  player: Player!
  game: Game!
  inningsPitched: Float
  hitsAllowed: Int
  runsAllowed: Int
  earnedRuns: Int
  walks: Int
  strikeouts: Int
  homeRunsAllowed: Int
  hitBatsmen: Int
  wildPitches: Int
  pitchCount: Int
  win: Boolean
  loss: Boolean
  creditedSave: Boolean
  era: Float
}

type BaseballPitchingStatsEdge implements Edge {
  node: BaseballPitchingStats!
  cursor: String!
}

type BaseballPitchingStatsConnection implements Connection {
  edges: [BaseballPitchingStatsEdge!]!
  pageInfo: PageInfo!
}

enum BaseballPitchingStatsSortField {
  INNINGS_PITCHED
  STRIKEOUTS
  ERA
  WALKS
}

input BaseballPitchingStatsSortInput {
  field: BaseballPitchingStatsSortField!
  direction: SortDirection = ASC
}

input SaveBaseballPitchingStatsInput {
  playerId: ID!
  gameId: ID!
  inningsPitched: Float
  hitsAllowed: Int
  runsAllowed: Int
  earnedRuns: Int
  walks: Int
  strikeouts: Int
  homeRunsAllowed: Int
  hitBatsmen: Int
  wildPitches: Int
  pitchCount: Int
  win: Boolean
  loss: Boolean
  creditedSave: Boolean
}

"""
Pitching stats data for a single player within a bulk save (gameId is at parent level).
"""
input SaveBaseballPitchingStatsData {
  playerId: ID!
  inningsPitched: Float
  hitsAllowed: Int
  runsAllowed: Int
  earnedRuns: Int
  walks: Int
  strikeouts: Int
  homeRunsAllowed: Int
  hitBatsmen: Int
  wildPitches: Int
  pitchCount: Int
  win: Boolean
  loss: Boolean
  creditedSave: Boolean
}

input SaveBaseballPitchingStatsBulkInput {
  gameId: ID!
  pitchingStats: [SaveBaseballPitchingStatsData!]!
}

type SaveBaseballPitchingStatsResponse {
  baseballPitchingStats: BaseballPitchingStats!
}

type SaveBaseballPitchingStatsBulkResponse {
  pitchingStats: [BaseballPitchingStats!]!
}

union SaveBaseballPitchingStatsResult =
  | SaveBaseballPitchingStatsResponse
  | GameNotFoundError
  | InvalidSportTypeError
union SaveBaseballPitchingStatsBulkResult =
  | SaveBaseballPitchingStatsBulkResponse
  | GameNotFoundError
  | InvalidSportTypeError

