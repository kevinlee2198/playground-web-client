  periods: Int
}

input CreateTennisGameMetadataInput {
  subtype: TennisSubtype!
  bestOf: Int
  tiebreakFinalSet: Boolean
}

input CreateFootballGameMetadataInput {
  subtype: FootballSubtype!
  periods: Int
}

input BasketballGameMetadataInput {
  subtype: BasketballSubtype
  periods: Int
}

input TennisGameMetadataInput {
  subtype: TennisSubtype
  bestOf: Int
  tiebreakFinalSet: Boolean
}

input FootballGameMetadataInput {
  subtype: FootballSubtype
  periods: Int
}

# ============================================================================
# Participant Metadata Inputs
# ============================================================================

input BasketballParticipantMetadataInput {
  score: Int!
}

input TennisParticipantMetadataInput {
  setsWon: Int!
  sets: [TennisSetScoreInput!]!
}

input TennisSetScoreInput {
  gamesWon: Int!
  tiebreakPoints: Int
}

input FootballParticipantMetadataInput {
  score: Int!
}

