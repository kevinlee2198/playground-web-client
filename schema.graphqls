"""
A player in a game. Persists across games
"""
type Player implements Node {
  id: ID!
  firstName: String!
  lastName: String!
  age: Int
  height: Float
  weight: Float
  biography: String
}

"""
Creates a new player
"""
input CreatePlayerInput {
  firstName: String!
  lastName: String!
  age: Int
  height: Float
  weight: Float
  biography: String
}

"""
Updates an existing player
Fields not specified will not be updated
"""
input UpdatePlayerInput {
  id: ID!
  """
  Omit a field to leave it unchanged.
  Setting to null here is not allowed
  """
  firstName: String
  """
  Omit a field to leave it unchanged.
  Setting to null here is not allowed
  """
  lastName: String
  """
  Omit a field to leave it unchanged.
  Setting to null here will set it to null on the database
  """
  age: Int
  """
  Omit a field to leave it unchanged.
  Setting to null here will set it to null on the database
  """
  height: Float
  """
  Omit a field to leave it unchanged.
  Setting to null here will set it to null on the database
  """
  weight: Float
  """
  Omit a field to leave it unchanged.
  Setting to null here will set it to null on the database
  """
  biography: String
}

"""
Deletes a player
"""
input DeletePlayerInput {
  id: ID!
}

type CreatePlayerResponse {
  player: Player!
}

type UpdatePlayerResponse {
  player: Player!
}

type DeletePlayerResponse implements DeleteResponse {
  id: ID
}
scalar DateTime
scalar JSON

"""
The direction to sort results
"""
enum SortDirection {
  ASC
  DESC
}

"""
Node IDs are unique only within a type
"""
interface Node {
  id: ID!
}

interface Edge {
  cursor: String!
  node: Node!
}

interface Connection {
  edges: [Edge!]!
  pageInfo: PageInfo!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

interface DeleteResponse {
  id: ID
}

interface HasLocation {
  location: Location
}

type Location {
  id: ID!
  name: String
  address: Address!
  coordinates: Coordinates
}

type Address {
  street: String!
  city: String!
  state: String!
  postalCode: String!
  country: String!
}

type Coordinates {
  latitude: Float!
  longitude: Float!
}

input LocationInput {
  name: String
  address: AddressInput!
  coordinates: CoordinatesInput
}

input AddressInput {
  street: String
  city: String
  state: String
  postalCode: String
  country: String!
}

input CoordinatesInput {
  latitude: Float!
  longitude: Float!
}

type Query {
  """
  Get a user by ID or username
  """
  user(input: QueryUserInput!): User
  """
  Get the user info for the current logged-in user.
  Returns additional private fields like email.
  """
  me: CurrentUser!
  """
  Search for users by name.
  """
  searchUsers(
    input: UserSearchInput!
    first: Int
    after: String
    last: Int
    before: String
  ): UserConnection!
  """
  Query friendships for the current user.
  Use filters to get pending requests, accepted friends, blocked users, etc.
  User must be authenticated.
  """
  friendships(
    input: FriendshipFilterInput
    first: Int
    after: String
    last: Int
    before: String
  ): FriendshipConnection!
  """
  Get a player by ID
  """
  player(id: ID!): Player
  """
  Get the player for the current logged-in user
  """
  currentPlayer: Player
  """
  Get a game by ID
  """
  game(id: ID!): Game
  """
  Query and filter games
  Filters are AND-ed together
  Sort entries are sorted in-order of the list
  """
  games(
    input: GameFilterInput!
    sort: [GameSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): GameConnection!
  """
  Query for notifications for the current user
  Notifications are sorted by created date
  User must be authenticated.
  """
  notifications(
    first: Int
    after: String
    last: Int
    before: String
  ): NotificationConnection!
  """
  Get a chat room
  User must be authenticated.
  """
  chatRoom(id: ID!): ChatRoom!
  """
  Query for chat rooms for the current user
  User must be authenticated.
  """
  chatRooms(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomConnection!
  """
  Find the direct message chat room between the current user and another user.
  Returns null if no DM exists.
  """
  directMessageChatRoom(userId: ID!): ChatRoom
  """
  Query and filter basketball box scores
  """
  basketballBoxScores(
    input: GameIdsAndPlayerIdsInput!
    sort: [BoxScoreSortInput!]
    first: Int
    after: String
    last: Int
    before: String
  ): BasketballBoxScoreConnection!
}

"""
Unless otherwise specified users must be authenticated before calling a mutation
When performing an update, only fields specified in the input will be updated
"""
type Mutation {
  """
  Create a new player.
  """
  createPlayer(input: CreatePlayerInput!): CreatePlayerResponse!
  """
  Update an existing player.
  """
  updatePlayer(input: UpdatePlayerInput!): UpdatePlayerResponse!
  """
  Delete a player.
  """
  deletePlayer(input: DeletePlayerInput!): DeletePlayerResponse!
  """
  Create a game.
  """
  createGame(input: CreateGameInput!): CreateGameResponse!
  """
  Update a game.
  """
  updateGame(input: UpdateGameInput!): UpdateGameResponse!
  """
  Delete a game.
  """
  deleteGame(input: DeleteGameInput!): DeleteGameResponse!
  """
  Add a participant to a game.
  Use teamInstance for team sports, individual for individual competition formats.
  """
  addGameParticipant(
    input: AddGameParticipantInput!
  ): AddGameParticipantResponse!
  """
  Add multiple participants to a game.
  """
  addGameParticipants(
    input: AddGameParticipantsInput!
  ): AddGameParticipantsResponse!
  """
  Update a participant in a game.
  Currently only team instances have updatable fields.
  """
  updateGameParticipant(
    input: UpdateGameParticipantInput!
  ): UpdateGameParticipantResponse!
  """
  Update multiple participants in a game.
  """
  updateGameParticipants(
    input: UpdateGameParticipantsInput!
  ): UpdateGameParticipantsResponse!
  """
  Remove a participant from a game.
  """
  removeGameParticipant(
    input: RemoveGameParticipantInput!
  ): RemoveGameParticipantResponse!
  """
  Remove multiple participants from a game.
  """
  removeGameParticipants(
    input: RemoveGameParticipantsInput!
  ): RemoveGameParticipantsResponse!
  """
  Add a player to an existing team instance.
  """
  addPlayerToTeamInstance(
    input: AddPlayerToTeamInstanceInput!
  ): AddPlayerToTeamInstanceResponse!
  """
  Add multiple players to an existing team instance.
  """
  addPlayersToTeamInstance(
    input: AddPlayersToTeamInstanceInput!
  ): AddPlayersToTeamInstanceResponse!
  """
  Remove a player from a team instance.
  """
  removePlayerFromTeamInstance(
    input: RemovePlayerFromTeamInstanceInput!
  ): RemovePlayerFromTeamInstanceResponse!
  """
  Remove multiple players from a team instance.
  """
  removePlayersFromTeamInstance(
    input: RemovePlayersFromTeamInstanceInput!
  ): RemovePlayersFromTeamInstanceResponse!
  """
  Start a game.
  Enables saving of statistics to the game.
  """
  startGame(input: StartGameInput!): StartGameResponse!
  """
  End a game.
  """
  endGame(input: EndGameInput!): EndGameResponse!
  """
  Start a livestream on a game
  """
  startLivestream(input: StartLivestreamInput!): StartLivestreamResponse!
  """
  End a livestream on a game
  """
  endLivestream(input: EndLivestreamInput!): EndLivestreamResponse!
  """
  Add a friend.
  """
  sendFriendRequest(input: SendFriendRequestInput!): SendFriendRequestResponse!
  """
  Accept a friend request.
  """
  acceptFriendRequest(
    input: AcceptFriendRequestInput!
  ): AcceptFriendRequestResponse!
  """
  Decline a friend request.
  """
  declineFriendRequest(
    input: DeclineFriendRequestInput!
  ): DeclineFriendRequestResponse!
  """
  Unfriend a user.
  """
  unfriend(input: UnfriendRequestInput!): UnfriendResponse!
  """
  Read notifications for the current user
  """
  readNotifications(input: ReadNotificationsInput!): ReadNotificationsResponse!
  """
  Create a chat room
  """
  createChatRoom(input: CreateChatRoomInput!): CreateChatRoomResponse!
  """
  Add a user to the chat room
  """
  addChatRoomMember(input: AddChatRoomMemberInput!): AddChatRoomMemberResponse!
  """
  Remove a user from the chat room
  """
  removeChatRoomMember(
    input: RemoveChatRoomMemberInput!
  ): RemoveChatRoomMemberResponse!
  """
  Send a chat message
  """
  sendChatMessage(input: SendChatMessageInput!): SendChatMessageResponse!
  """
  Update a chat message
  """
  updateChatMessage(input: UpdateChatMessageInput!): UpdateChatMessageResponse!
  """
  Delete a message
  """
  deleteChatMessage(input: DeleteChatMessageInput!): DeleteChatMessageResponse!
  """
  Save a box score for a basketball game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveBasketballBoxScore(
    input: SaveBasketballBoxScoreInput!
  ): SaveBasketballBoxScoreResponse!
  """
  Save box scores for a basketball game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveBasketballBoxScores(
    input: SaveBasketballBoxScoresInput!
  ): SaveBasketballBoxScoresResponse!
}

type Subscription {
  chatEvents(chatRoomId: ID!): ChatEvent!
  notificationEvents: NotificationEvent!
}
"""
Identifies a resource unique to a player in a game
"""
input GameIdsAndPlayerIdsInput {
  gameIds: [ID!]
  playerIds: [ID!]
}

"""
Box scores for basketball
"""
type BasketballBoxScore implements Node {
  id: ID!
  player: Player!
  game: Game!
  defensiveRebounds: Int
  offensiveRebounds: Int
  totalRebounds: Int
  assists: Int
  steals: Int
  blocks: Int
  turnovers: Int
  personalFouls: Int
  points: Int
  threePointersMade: Int
  threePointersAttempted: Int
  threePointerPercentage: Float
  twoPointersMade: Int
  twoPointersAttempted: Int
  twoPointerPercentage: Float
  freeThrowsMade: Int
  freeThrowsAttempted: Int
  freeThrowPercentage: Float
  fieldGoalsMade: Int
  fieldGoalsAttempted: Int
  fieldGoalPercentage: Float
}

type BasketballBoxScoreEdge implements Edge {
  node: BasketballBoxScore!
  cursor: String!
}

type BasketballBoxScoreConnection implements Connection {
  edges: [BasketballBoxScoreEdge!]!
  pageInfo: PageInfo!
}

enum BoxScoreSortField {
  POINTS
  ASSISTS
  TOTAL_REBOUNDS
  STEALS
  BLOCKS
}

input BoxScoreSortInput {
  field: BoxScoreSortField!
  direction: SortDirection = ASC
}

input SaveBasketballBoxScoresInput {
  basketballBoxScores: [SaveBasketballBoxScoreInput!]!
}

input SaveBasketballBoxScoreInput {
  playerId: ID!
  gameId: ID!
  defensiveRebounds: Int
  offensiveRebounds: Int
  assists: Int
  steals: Int
  blocks: Int
  turnovers: Int
  personalFouls: Int
  threePointersMade: Int
  threePointersAttempted: Int
  twoPointersMade: Int
  twoPointersAttempted: Int
  freeThrowsMade: Int
  freeThrowsAttempted: Int
}

type SaveBasketballBoxScoresResponse {
  basketballBoxScores: [BasketballBoxScore!]!
}

type SaveBasketballBoxScoreResponse {
  basketballBoxScore: BasketballBoxScore!
}
"""
A Playground user
"""
type User implements Node {
  id: ID!
  username: String!
  firstName: String!
  lastName: String!
  player: Player
  friendship: Friendship
}

"""
The current authenticated user with private fields
"""
type CurrentUser implements Node {
  id: ID!
  username: String!
  firstName: String!
  lastName: String!
  email: String!
  player: Player
}

"""
Something that is related to a user
"""
interface HasUser {
  user: User!
}

"""
The Friendship status between two users
"""
enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

"""
Direction of a friendship relative to the current user
"""
enum FriendshipDirection {
  """
  Requests sent TO the current user
  """
  INCOMING
  """
  Requests sent BY the current user
  """
  OUTGOING
}

"""
The Friendship between two users
Can be bidirectional - ACCEPTED status
Can be unidirectional - PENDING status
"""
type Friendship implements Node {
  id: ID!
  requester: User!
  addressee: User!
  status: FriendshipStatus!
  createdDate: DateTime!
}

type FriendshipEdge implements Edge {
  cursor: String!
  node: Friendship!
}

type FriendshipConnection implements Connection {
  edges: [FriendshipEdge!]!
  pageInfo: PageInfo!
}

"""
Filters for querying friendships
"""
input FriendshipFilterInput {
  """
  Filter by friendship status
  """
  status: FriendshipStatus
  """
  Filter by direction relative to current user.
  INCOMING = other users requested me, OUTGOING = I requested them.
  If null, returns both directions.
  """
  direction: FriendshipDirection
}

type UserEdge implements Edge {
  cursor: String!
  node: User!
}

type UserConnection implements Connection {
  edges: [UserEdge!]!
  pageInfo: PageInfo!
}

input SendFriendRequestInput {
  userId: ID!
}

type SendFriendRequestResponse {
  friendship: Friendship!
}

input AcceptFriendRequestInput {
  requesterId: ID!
}

type AcceptFriendRequestResponse {
  friendship: Friendship!
}

input DeclineFriendRequestInput {
  requesterId: ID!
}

type DeclineFriendRequestResponse {
  friendship: Friendship!
}

input UnfriendRequestInput {
  userId: ID!
}

type UnfriendResponse {
  friendship: Friendship
}

type Notification implements Node {
  id: ID!
  body: String!
  isRead: Boolean!
  createdDate: DateTime!
}

type NotificationEdge implements Edge {
  cursor: String!
  node: Notification!
}

type NotificationConnection implements Connection {
  edges: [NotificationEdge!]!
  pageInfo: PageInfo!
}

input ReadNotificationsInput {
  ids: [ID!]!
}

type ReadNotificationsResponse {
  notifications: [Notification!]!
}

type NotificationEvent {
  notification: Notification!
}

input QueryUserInput @oneOf {
  id: ID
  username: String
}

input UserSearchInput {
  query: String!
  #    excludeFriends: Boolean
  #    hasFriendshipStatus: FriendshipStatus
  #    hasPlayer: Boolean
}
