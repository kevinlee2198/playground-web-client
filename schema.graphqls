}

type UpdateChatRoomMemberRoleResponse {
  """
  The updated ChatRoomMember record.
  """
  member: ChatRoomMember!
  """
  Only populated when transferring ownership — the previous owner's updated record (now a Member).
  """
  previousOwner: ChatRoomMember
}

# ============================================================================
# Chat Result Unions
# ============================================================================

union CreateDirectMessageResult =
  | CreateDirectMessageResponse
  | UserBlockedError
  | MutualFollowRequiredError
union CreateGroupChatResult = CreateGroupChatResponse | EmptyChatRoomError
union AddChatRoomMemberResult =
  | AddChatRoomMemberResponse
  | ChatRoomNotFoundError
  | DirectMessageNotAllowedError
  | ManagedChatRoomError
  | MutualFollowRequiredError
union RemoveChatRoomMemberResult =
  | RemoveChatRoomMemberResponse
  | ChatRoomNotFoundError
  | UserNotFoundError
  | DirectMessageNotAllowedError
  | ManagedChatRoomError
  | CannotRemoveOwnerError
  | InsufficientRoleError
union RenameChatRoomResult =
  | RenameChatRoomResponse
  | ChatRoomNotFoundError
  | DirectMessageNotAllowedError
  | ManagedChatRoomError
union UpdateChatRoomMemberRoleResult =
  | UpdateChatRoomMemberRoleResponse
  | ChatRoomNotFoundError
  | UserNotFoundError
  | DirectMessageNotAllowedError
  | ManagedChatRoomError
  | InvalidRoleTransitionError
union LeaveChatRoomResult =
  | LeaveChatRoomResponse
  | ChatRoomNotFoundError
  | UserNotFoundError
  | DirectMessageNotAllowedError
  | ManagedChatRoomError
  | OwnerCannotLeaveError
union SendChatMessageResult =
  | SendChatMessageResponse
  | ChatRoomNotFoundError
  | MutualFollowRequiredError
union UpdateChatMessageResult =
  | UpdateChatMessageResponse
  | ChatMessageNotFoundError
  | MessageNotEditableError
union DeleteChatMessageResult =
  | DeleteChatMessageResponse
  | ChatMessageNotFoundError
"""
Common interface for all domain errors returned as part of result unions.
Clients can use `... on Error { message }` as a catch-all.

Conventions:
- Unauthenticated callers always fail with a top-level UNAUTHORIZED error.
- Legacy core mutations keep a top-level FORBIDDEN error when the caller lacks permission.
- League, group, invite and organization mutations, and new core mutations, return a typed
  `AuthorizationError` instead.
- Authorize before revealing: a caller who may not see a resource is told it does not exist or is
  denied, never which of the two.
- `InvalidInputError` reports server-only field rules (for example clearing a non-nullable field).
  Shape-only validation stays a top-level BAD_REQUEST.
"""
interface Error {
  message: String!
}

"""
The caller is authenticated but not permitted to perform this action.
"""
interface AuthorizationError implements Error {
  message: String!
}

"""
An input field broke a rule only the server can check.
"""
type InvalidInputError implements Error {
  message: String!
  """
  Input field path, null when the rule spans fields.
  """
  field: String
  """
  Stable machine code, e.g. NULL_NOT_ALLOWED.
  """
  code: String!
}

"""
Rate limit exceeded. Retry after retryAfterSeconds.
"""
type RateLimitedError implements Error {
  message: String!
  """
  Seconds until the caller can try again.
  """
  retryAfterSeconds: Int!
}

# ============================================================================
# Game Errors
# ============================================================================

type GameNotFoundError implements Error {
  message: String!
  gameId: ID!
}

type InvalidSportConfigError implements Error {
  message: String!
}

type InvalidDateRangeError implements Error {
