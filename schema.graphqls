# ============================================================================
# Tennis Statistics
# ============================================================================

"""
Filter for tennis statistics by game and/or player.
At least one of gameIds or playerIds must be provided.
"""
input TennisStatisticsFilterInput {
  gameIds: [ID!]
  playerIds: [ID!]
}

"""
Tennis match statistics for a single player in a game.
Covers serving, returning, and general point play.
"""
type TennisStatistics implements Node {
  id: ID!
  player: Player!
  game: Game!
  """
  Number of aces served
  """
  aces: Int
  """
  Number of double faults
  """
  doubleFaults: Int
  """
  Number of first serves that landed in
  """
  firstServesIn: Int
  """
  Total number of first serve attempts
  """
  firstServeAttempts: Int
  """
  Points won when the first serve was in
  """
  firstServePointsWon: Int
  """
  Total points played on first serve
  """
  firstServePointsPlayed: Int
  """
  Points won when the second serve was in
  """
  secondServePointsWon: Int
  """
  Total points played on second serve
  """
  secondServePointsPlayed: Int
  """
  Number of break points converted
  """
  breakPointsConverted: Int
  """
  Number of break points faced
  """
  breakPointsFaced: Int
  """
  Points won on return of serve
  """
  returnPointsWon: Int
  """
  Total return points played
  """
  returnPointsPlayed: Int
  """
  Number of outright winners hit
  """
  winners: Int
  """
  Number of unforced errors
  """
  unforcedErrors: Int
  """
  Total points won in the match
  """
  totalPointsWon: Int
}

type TennisStatisticsEdge implements Edge {
  node: TennisStatistics!
  cursor: String!
}

type TennisStatisticsConnection implements Connection {
  edges: [TennisStatisticsEdge!]!
  pageInfo: PageInfo!
}

enum TennisStatisticsSortField {
  ACES
  TOTAL_POINTS_WON
  WINNERS
  UNFORCED_ERRORS
  DOUBLE_FAULTS
}

input TennisStatisticsSortInput {
  field: TennisStatisticsSortField!
  direction: SortDirection = ASC
}

input SaveTennisStatisticsInput {
  playerId: ID!
  gameId: ID!
  aces: Int
  doubleFaults: Int
  firstServesIn: Int
  firstServeAttempts: Int
  firstServePointsWon: Int
  firstServePointsPlayed: Int
  secondServePointsWon: Int
  secondServePointsPlayed: Int
  breakPointsConverted: Int
  breakPointsFaced: Int
  returnPointsWon: Int
  returnPointsPlayed: Int
  winners: Int
  unforcedErrors: Int
  totalPointsWon: Int
}

"""
Tennis statistics data for a single player within a bulk save (gameId is at parent level).
"""
input SaveTennisStatisticsData {
  playerId: ID!
  aces: Int
  doubleFaults: Int
  firstServesIn: Int
  firstServeAttempts: Int
  firstServePointsWon: Int
  firstServePointsPlayed: Int
  secondServePointsWon: Int
  secondServePointsPlayed: Int
  breakPointsConverted: Int
  breakPointsFaced: Int
  returnPointsWon: Int
  returnPointsPlayed: Int
  winners: Int
  unforcedErrors: Int
  totalPointsWon: Int
}

input SaveTennisStatisticsBulkInput {
  gameId: ID!
  statistics: [SaveTennisStatisticsData!]!
}

type SaveTennisStatisticsResponse {
  tennisStatistics: TennisStatistics!
}

type SaveTennisStatisticsBulkResponse {
  statistics: [TennisStatistics!]!
}

union SaveTennisStatisticsResult =
  | SaveTennisStatisticsResponse
  | GameNotFoundError
  | InvalidSportTypeError
union SaveTennisStatisticsBulkResult =
  | SaveTennisStatisticsBulkResponse
  | GameNotFoundError
  | InvalidSportTypeError

