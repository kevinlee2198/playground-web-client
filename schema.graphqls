interface ChatMessage implements Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
}

interface UserChatMessage implements ChatMessage & Node & HasUser {
  id: ID!
  chatRoom: ChatRoom!
  user: User!
  createdDate: DateTime!
  """
  if a user has edited their message this field will be present. It will not be present for deletion
  """
  updatedDate: DateTime
  """
  If a user has deleted their message this field will be present
  """
  deletedDate: DateTime
  """
  For threaded conversations
  """
  replyTo: UserChatMessage
}

type TextChatMessage implements UserChatMessage & ChatMessage & Node & HasUser {
  id: ID!
  chatRoom: ChatRoom!
  user: User!
  """
  Can be null if the message has been deleted
  """
  content: String
  createdDate: DateTime!
  """
  if a user has edited their message this field will be present. It will not be present for deletion
  """
  updatedDate: DateTime
  """
  If a user has deleted their message this field will be present
  """
  deletedDate: DateTime
  """
  For threaded conversations
  """
  replyTo: UserChatMessage
}

"""
A chat message with an attached file or image.
The resource's concrete type (ImageResource vs FileResource) indicates
the kind of media. Use inline fragments on the resource field:

```graphql
... on MediaChatMessage {
  caption
  resource {
    filename
    downloadUrl
    ... on ImageResource { width height thumbnailUrl }
  }
}
```
"""
type MediaChatMessage implements UserChatMessage & ChatMessage & Node & HasUser {
  id: ID!
  chatRoom: ChatRoom!
  user: User!
  createdDate: DateTime!
  """
  if a user has edited their message this field will be present. It will not be present for deletion
  """
  updatedDate: DateTime
  """
  If a user has deleted their message this field will be present
  """
  deletedDate: DateTime
  """
  For threaded conversations
  """
  replyTo: UserChatMessage
  """
  The attached file or image resource.
  """
  resource: Resource!
  """
  Optional caption for the media.
  """
  caption: String
}

interface SystemChatMessage implements ChatMessage & Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
}

type MemberJoinedChatMessage implements SystemChatMessage & ChatMessage & Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
  member: User!
}

type MemberLeftChatMessage implements SystemChatMessage & ChatMessage & Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
  member: User!
}

type ChatMessageEdge implements Edge {
  cursor: String!
  node: ChatMessage!
}

type ChatMessageConnection implements Connection {
  edges: [ChatMessageEdge!]!
  pageInfo: PageInfo!
}

enum ChatRoomRole {
  OWNER
  ADMIN
  MEMBER
}

type ChatRoomMember implements HasUser & Node {
  id: ID!
  user: User!
  role: ChatRoomRole!
  joinedDate: DateTime!
}

type ChatRoomMemberEdge implements Edge {
  cursor: String!
  node: ChatRoomMember!
}

type ChatRoomMemberConnection implements Connection {
  edges: [ChatRoomMemberEdge!]!
  pageInfo: PageInfo!
}

type ChatRoomViewerCan {
  """
  Viewer is a member. DMs also require the mutual follow.
  """
  sendMessage: Boolean!
  """
  chat_room add-member check. Always false for league- and group-managed rooms (N6).
  """
  addMember: Boolean!
  """
  chat_room remove-member check. Always false for managed rooms (N6).
  """
  removeMember: Boolean!
  """
  chat_room rename check. Always false for managed rooms (N6).
  """
  rename: Boolean!
  """
  Member of a non-DM room. Always false for managed rooms (N6).
  """
  leave: Boolean!
  """
  Change a member's role or transfer ownership. Always false for managed rooms (N6).
  """
  updateMemberRole: Boolean!
}

interface ChatRoom implements Node {
  id: ID!
  createdDate: DateTime!
  lastModifiedDate: DateTime!
  """
  What the authenticated viewer may do in this room.
  """
  viewerCan: ChatRoomViewerCan!
  """
  Members of the room
  """
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomMemberConnection!

  """
  Messages ordered by createdDate ASC.
  Use `last` to fetch the most recent chatMessages.
  """
  chatMessages(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatMessageConnection!
}

type DirectMessageChatRoom implements ChatRoom & Node {
  id: ID!
  createdDate: DateTime!
  lastModifiedDate: DateTime!
  viewerCan: ChatRoomViewerCan!
  """
  Whether the authenticated viewer can send messages in this DM.
  False when the mutual follow relationship is broken.
  """
  canMessage: Boolean! @deprecated(reason: "Use viewerCan.sendMessage")
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomMemberConnection!
  """
  Messages ordered by createdDate ASC.
  Use `last` to fetch the most recent messages; `before` to load older messages.
  """
  chatMessages(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatMessageConnection!
}

type GroupChatRoom implements ChatRoom & Node {
  id: ID!
  name: String!
  createdDate: DateTime!
  lastModifiedDate: DateTime!
  viewerCan: ChatRoomViewerCan!
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomMemberConnection!
  """
  Messages ordered by createdDate ASC.
  Use `last` to fetch the most recent messages; `before` to load older messages.
  """
  chatMessages(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatMessageConnection!
}

type ChatRoomEdge implements Edge {
  cursor: String!
  node: ChatRoom!
}

type ChatRoomConnection implements Connection {
  edges: [ChatRoomEdge!]!
  pageInfo: PageInfo!
}

