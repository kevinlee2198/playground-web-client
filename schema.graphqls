union CreateGameResult = CreateGameResponse | InvalidSportConfigError
union UpdateGameResult = UpdateGameResponse | GameNotFoundError | InvalidSportConfigError | InvalidDateRangeError
union DeleteGameResult = DeleteGameResponse | GameNotFoundError
union StartGameResult = StartGameResponse | GameNotFoundError | InvalidGameStatusTransitionError
union EndGameResult = EndGameResponse | GameNotFoundError | InvalidGameStatusTransitionError
union FinalizeGameResultsResult = FinalizeGameResultsResponse | GameNotFoundError
union UnfinalizeGameResultsResult = UnfinalizeGameResultsResponse | GameNotFoundError
union AddGameParticipantResult = AddGameParticipantResponse | GameNotFoundError | PlayerNotFoundError | InvalidParticipantTypeError
union AddGameParticipantsResult = AddGameParticipantsResponse | GameNotFoundError | PlayerNotFoundError | InvalidParticipantTypeError
union UpdateGameParticipantResult = UpdateGameParticipantResponse | GameNotFoundError | ParticipantNotFoundError
union UpdateGameParticipantsResult = UpdateGameParticipantsResponse | GameNotFoundError | ParticipantNotFoundError
union RemoveGameParticipantResult = RemoveGameParticipantResponse | GameNotFoundError | ParticipantNotFoundError
union RemoveGameParticipantsResult = RemoveGameParticipantsResponse | GameNotFoundError | ParticipantNotFoundError
union AddPlayerToTeamInstanceResult = AddPlayerToTeamInstanceResponse | TeamInstanceNotFoundError | PlayerNotFoundError
union AddPlayersToTeamInstanceResult = AddPlayersToTeamInstanceResponse | TeamInstanceNotFoundError | PlayerNotFoundError
union RemovePlayerFromTeamInstanceResult = RemovePlayerFromTeamInstanceResponse | TeamInstanceNotFoundError | PlayerNotFoundError
union RemovePlayersFromTeamInstanceResult = RemovePlayersFromTeamInstanceResponse | TeamInstanceNotFoundError | PlayerNotFoundErrorenum LivestreamProvider {
    YOUTUBE,
    TWITCH
}

