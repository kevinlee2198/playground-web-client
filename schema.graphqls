union UpdateLivestreamResult = UpdateLivestreamResponse | LivestreamNotFoundError"""
A player in a game. Persists across games.
Identifying fields (firstName, lastName, age, height, weight, biography, user)
may be null if the viewer has a blocking relationship with this player's user.
"""
type Player implements Node {
    id: ID!
    """Null when the viewer has a blocking relationship with this player's user."""
    firstName: String
    """Null when the viewer has a blocking relationship with this player's user."""
    lastName: String
    """Null when the viewer has a blocking relationship with this player's user."""
    age: Int
    """Null when the viewer has a blocking relationship with this player's user."""
    height: Float
    """Null when the viewer has a blocking relationship with this player's user."""
    weight: Float
    biography: String
    """Null when the viewer has a blocking relationship with this player's user."""
    user: User
}

"""
Creates a new player
"""
input CreatePlayerInput {
    firstName: String!
    lastName: String!
    age: Int
    height: Float
    weight: Float
    biography: String
}

"""
Updates an existing player
Fields not specified will not be updated
"""
input UpdatePlayerInput {
    id: ID!
    """
    Omit a field to leave it unchanged.
    Setting to null here is not allowed
    """
    firstName: String
    """
    Omit a field to leave it unchanged.
    Setting to null here is not allowed
    """
    lastName: String
    """
    Omit a field to leave it unchanged.
    Setting to null here will set it to null on the database
    """
    age: Int
    """
    Omit a field to leave it unchanged.
    Setting to null here will set it to null on the database
    """
    height: Float
    """
    Omit a field to leave it unchanged.
    Setting to null here will set it to null on the database
    """
    weight: Float
    """
    Omit a field to leave it unchanged.
    Setting to null here will set it to null on the database
    """
    biography: String
}

"""
Deletes a player
"""
input DeletePlayerInput {
    id: ID!
}

