  Only available for games that are IN_PROGRESS or COMPLETE
  """
  savePickleballStats(
    input: SavePickleballStatsInput!
  ): SavePickleballStatsResult!
  """
  Save stats for multiple players in a pickleball game.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  savePickleballStatsBulk(
    input: SavePickleballStatsBulkInput!
  ): SavePickleballStatsBulkResult!
  """
  Save stats for a tennis match.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveTennisStats(input: SaveTennisStatsInput!): SaveTennisStatsResult!
  """
  Save stats for multiple players in a tennis match.
  Only available for games that are IN_PROGRESS or COMPLETE
  """
  saveTennisStatsBulk(
    input: SaveTennisStatsBulkInput!
