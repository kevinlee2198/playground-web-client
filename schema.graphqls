interface ChatMessage implements Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
}

interface UserChatMessage implements ChatMessage & Node & HasUser {
  id: ID!
  chatRoom: ChatRoom!
  user: User!
  createdDate: DateTime!
  """
  if a user has edited their message this field will be present. It will not be present for deletion
  """
  updatedDate: DateTime
  """
  If a user has deleted their message this field will be present
  """
  deletedDate: DateTime
  """
  For threaded conversations
  """
  replyTo: UserChatMessage
}

type TextChatMessage implements UserChatMessage & ChatMessage & Node & HasUser {
  id: ID!
  chatRoom: ChatRoom!
  user: User!
  """
  Can be null if the message has been deleted
  """
  content: String
  createdDate: DateTime!
  """
  if a user has edited their message this field will be present. It will not be present for deletion
  """
  updatedDate: DateTime
  """
  If a user has deleted their message this field will be present
  """
  deletedDate: DateTime
  """
  For threaded conversations
  """
  replyTo: UserChatMessage
}

"""
A chat message with an attached file or image.
The resource's concrete type (ImageResource vs FileResource) indicates
the kind of media. Use inline fragments on the resource field:

```graphql
... on MediaChatMessage {
  caption
  resource {
    filename
    downloadUrl
    ... on ImageResource { width height thumbnailUrl }
  }
}
```
"""
type MediaChatMessage implements UserChatMessage & ChatMessage & Node & HasUser {
  id: ID!
  chatRoom: ChatRoom!
  user: User!
  createdDate: DateTime!
  """
  if a user has edited their message this field will be present. It will not be present for deletion
  """
  updatedDate: DateTime
  """
  If a user has deleted their message this field will be present
  """
  deletedDate: DateTime
  """
  For threaded conversations
  """
  replyTo: UserChatMessage
  """
  The attached file or image resource.
  """
  resource: Resource!
  """
  Optional caption for the media.
  """
  caption: String
}

interface SystemChatMessage implements ChatMessage & Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
}

type MemberJoinedChatMessage implements SystemChatMessage & ChatMessage & Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
  member: User!
}

type MemberLeftChatMessage implements SystemChatMessage & ChatMessage & Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
  member: User!
}

type ChatMessageEdge implements Edge {
  cursor: String!
  node: ChatMessage!
}

type ChatMessageConnection implements Connection {
  edges: [ChatMessageEdge!]!
  pageInfo: PageInfo!
}

enum ChatRoomRole {
  OWNER
  ADMIN
  MEMBER
}

type ChatRoomMember implements HasUser & Node {
  id: ID!
  user: User!
  role: ChatRoomRole!
  joinedDate: DateTime!
}

type ChatRoomMemberEdge implements Edge {
  cursor: String!
  node: ChatRoomMember!
}

type ChatRoomMemberConnection implements Connection {
  edges: [ChatRoomMemberEdge!]!
  pageInfo: PageInfo!
}

interface ChatRoom implements Node {
  id: ID!
  createdDate: DateTime!
  lastModifiedDate: DateTime!
  """
  Members of the room
  """
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomMemberConnection!

  """
  Messages ordered by createdDate ASC.
  Use `last` to fetch the most recent chatMessages.
  """
  chatMessages(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatMessageConnection!
}

type DirectMessageChatRoom implements ChatRoom & Node {
  id: ID!
  createdDate: DateTime!
  lastModifiedDate: DateTime!
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomMemberConnection!
  """
  Messages ordered by createdDate ASC.
  Use `last` to fetch the most recent messages; `before` to load older messages.
  """
  chatMessages(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatMessageConnection!
}

type GroupChatRoom implements ChatRoom & Node {
  id: ID!
  name: String!
  createdDate: DateTime!
  lastModifiedDate: DateTime!
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomMemberConnection!
  """
  Messages ordered by createdDate ASC.
  Use `last` to fetch the most recent messages; `before` to load older messages.
  """
  chatMessages(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatMessageConnection!
}

type ChatRoomEdge implements Edge {
  cursor: String!
  node: ChatRoom!
}

type ChatRoomConnection implements Connection {
  edges: [ChatRoomEdge!]!
  pageInfo: PageInfo!
}

input CreateDirectMessageInput {
  userId: ID!
}

type CreateDirectMessageResponse {
  chatRoom: ChatRoom!
}

input CreateGroupChatInput {
  name: String!
  userIds: [ID!]!
}

type CreateGroupChatResponse {
  chatRoom: ChatRoom!
}

input AddChatRoomMemberInput {
  chatRoomId: ID!
  userId: ID!
}

type AddChatRoomMemberResponse {
  member: ChatRoomMember!
}

input RemoveChatRoomMemberInput {
  chatRoomId: ID!
  userId: ID!
}

type RemoveChatRoomMemberResponse {
  chatRoomId: ID!
  userId: ID!
}

type SendChatMessageResponse {
  chatMessage: ChatMessage!
}

input SendTextChatMessageInput {
  chatRoomId: ID!
  content: String!
  replyToId: ID
}

"""
Send a media message. The resourceId must reference a resource that was
uploaded via requestUpload with a chatMedia context.
Sending the message also confirms the resource (transitions it to PERMANENT) —
do NOT call confirmUpload separately for chat media.
"""
input SendMediaChatMessageInput {
  chatRoomId: ID!
  """
  The resource ID returned from requestUpload.
  """
  resourceId: ID!
  caption: String
  replyToId: ID
}

"""
Polymorphic input for sending different types of chat messages.
Exactly one field must be provided.
"""
input SendChatMessageInput @oneOf {
  textMessage: SendTextChatMessageInput
  mediaMessage: SendMediaChatMessageInput
}

input UpdateTextChatMessageInput {
  id: ID!
  content: String!
}

"""
Polymorphic input for updating different types of chat messages.
Exactly one field must be provided.
"""
input UpdateChatMessageInput @oneOf {
  textMessage: UpdateTextChatMessageInput
}

type UpdateChatMessageResponse {
  chatMessage: ChatMessage!
}

input DeleteChatMessageInput {
  id: ID!
}

type DeleteChatMessageResponse implements DeleteResponse {
  id: ID!
}

interface ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
}

interface ChatMessageEvent implements ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  chatMessage: ChatMessage!
}

type ChatMessageSentEvent implements ChatMessageEvent & ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  chatMessage: ChatMessage!
}

type ChatMessageUpdatedEvent implements ChatMessageEvent & ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  chatMessage: ChatMessage!
}

type ChatMessageDeletedEvent implements ChatMessageEvent & ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  chatMessage: ChatMessage!
}

type ChatRoomMemberAddedEvent implements ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  member: ChatRoomMember!
}

type ChatRoomMemberRemovedEvent implements ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  userId: ID!
}

input RenameChatRoomInput {
  chatRoomId: ID!
  name: String!
}

type RenameChatRoomResponse {
  chatRoom: ChatRoom!
}

input LeaveChatRoomInput {
  chatRoomId: ID!
}

type LeaveChatRoomResponse {
  chatRoomId: ID!
}

input UpdateChatRoomMemberRoleInput {
  chatRoomId: ID!
  userId: ID!
  role: ChatRoomRole!
}

type UpdateChatRoomMemberRoleResponse {
  """
  The updated ChatRoomMember record.
  """
  member: ChatRoomMember!
  """
  Only populated when transferring ownership — the previous owner's updated record (now a Member).
  """
  previousOwner: ChatRoomMember
}

# ============================================================================
# Chat Result Unions
# ============================================================================

union CreateDirectMessageResult = CreateDirectMessageResponse | UserBlockedError
union CreateGroupChatResult = CreateGroupChatResponse | EmptyChatRoomError
union AddChatRoomMemberResult =
  | AddChatRoomMemberResponse
  | ChatRoomNotFoundError
  | DirectMessageNotAllowedError
union RemoveChatRoomMemberResult =
  | RemoveChatRoomMemberResponse
  | ChatRoomNotFoundError
  | UserNotFoundError
  | DirectMessageNotAllowedError
  | CannotRemoveOwnerError
  | InsufficientRoleError
union RenameChatRoomResult =
  | RenameChatRoomResponse
  | ChatRoomNotFoundError
  | DirectMessageNotAllowedError
union UpdateChatRoomMemberRoleResult =
  | UpdateChatRoomMemberRoleResponse
  | ChatRoomNotFoundError
  | UserNotFoundError
  | DirectMessageNotAllowedError
  | InvalidRoleTransitionError
union LeaveChatRoomResult =
  | LeaveChatRoomResponse
  | ChatRoomNotFoundError
  | UserNotFoundError
  | DirectMessageNotAllowedError
  | OwnerCannotLeaveError
union SendChatMessageResult = SendChatMessageResponse | ChatRoomNotFoundError
union UpdateChatMessageResult =
  | UpdateChatMessageResponse
  | ChatMessageNotFoundError
  | MessageNotEditableError
union DeleteChatMessageResult =
  | DeleteChatMessageResponse
  | ChatMessageNotFoundError
"""
Common interface for all domain errors returned as part of result unions.
Clients can use `... on Error { message }` as a catch-all.
Infrastructure errors (UNAUTHORIZED, FORBIDDEN) remain in the GraphQL errors array.
"""
interface Error {
  message: String!
}

# ============================================================================
# Game Errors
# ============================================================================

type GameNotFoundError implements Error {
  message: String!
  gameId: ID!
}

type InvalidSportConfigError implements Error {
  message: String!
}

type InvalidDateRangeError implements Error {
  message: String!
}

type InvalidGameStatusTransitionError implements Error {
  message: String!
  currentStatus: GameStatus!
}

type PlayerNotFoundError implements Error {
  message: String!
  playerId: ID
  playerIds: [ID!]
}

type ParticipantNotFoundError implements Error {
  message: String!
  participantId: ID!
}

type TeamInstanceNotFoundError implements Error {
  message: String!
  teamInstanceId: ID!
}

type InvalidParticipantTypeError implements Error {
  message: String!
}

# ============================================================================
# Livestream Errors
# ============================================================================

type LivestreamNotFoundError implements Error {
  message: String!
  livestreamId: ID!
}

# ============================================================================
# User / Friendship Errors
# ============================================================================

type UserNotFoundError implements Error {
  message: String!
  userId: ID!
}

type SelfActionError implements Error {
  message: String!
}

type FriendshipAlreadyExistsError implements Error {
  message: String!
  currentStatus: FriendshipStatus!
}

type FriendRequestNotFoundError implements Error {
  message: String!
}

type InvalidFriendshipStateError implements Error {
  message: String!
  currentStatus: FriendshipStatus!
}

type UserBlockedYouError implements Error {
  message: String!
}

type BlockNotFoundError implements Error {
  message: String!
}

# ============================================================================
# Chat Errors
# ============================================================================

type ChatRoomNotFoundError implements Error {
  message: String!
  chatRoomId: ID!
}

type ChatMessageNotFoundError implements Error {
  message: String!
}

type DirectMessageNotAllowedError implements Error {
  message: String!
}

type UserBlockedError implements Error {
  message: String!
}

type EmptyChatRoomError implements Error {
  message: String!
}

type CannotRemoveOwnerError implements Error {
  message: String!
}

type InsufficientRoleError implements Error {
  message: String!
}

type InvalidRoleTransitionError implements Error {
  message: String!
  currentRole: ChatRoomRole!
  requestedRole: ChatRoomRole!
}

type OwnerCannotLeaveError implements Error {
  message: String!
}

type MessageNotEditableError implements Error {
  message: String!
}

# ============================================================================
# Notification Errors
# ============================================================================

type NotificationNotFoundError implements Error {
  message: String!
}

# ============================================================================
# Statistic Errors
# ============================================================================

type InvalidSportTypeError implements Error {
  message: String!
  expectedSportType: SportType!
  actualSportType: SportType!
}

# ============================================================================
# Resource Errors
# ============================================================================

type ResourceNotFoundError implements Error {
  message: String!
}

type InvalidUploadContextError implements Error {
  message: String!
}
"""
Management roles for a game, independent from being a participant.
"""
enum GameRole {
  OWNER
  EDITOR
}

"""
A user with a management role in a game.
"""
type GameMember implements HasUser & Node {
  id: ID!
  user: User!
  role: GameRole!
}

type GameMemberEdge implements Edge {
  cursor: String!
  node: GameMember!
}

type GameMemberConnection implements Connection {
  edges: [GameMemberEdge!]!
  pageInfo: PageInfo!
}

"""
What state a game is in.
"""
enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETE
}

"""
Controls who can discover, view, and join a game.
"""
enum GameVisibility {
  PUBLIC
  PROTECTED
  PRIVATE
}

"""
Who can enter statistics for a game.
"""
enum StatEntryMode {
  OPEN
  SELF_REPORT
}

"""
Different sport types supported by Playground
"""
enum SportType {
  BASEBALL
  BASKETBALL
  FOOTBALL
  TENNIS
  PICKLEBALL
}

enum BasketballFormat {
  FIVE_ON_FIVE
  THREE_ON_THREE
}

enum TennisFormat {
  SINGLES
  DOUBLES
}

enum FootballFormat {
  FLAG_FOOTBALL
  AMERICAN_FOOTBALL
}

enum PickleballFormat {
  SINGLES
  DOUBLES
}

enum PickleballScoringType {
  SIDE_OUT
  RALLY
}

# ============================================================================
# Game Metadata
# ============================================================================

"""
Sport-specific game configuration and rules.
Clients branch on Game.sportType and use inline fragments for sport-specific fields.
"""
union GameMetadata =
  | BaseballGameMetadata
  | BasketballGameMetadata
  | TennisGameMetadata
  | FootballGameMetadata
  | PickleballGameMetadata

type BaseballGameMetadata {
  """
  Number of innings
  """
  innings: Int
}

type BasketballGameMetadata {
  format: BasketballFormat!
  """
  Number of periods (e.g. 4 for quarters, 2 for halves)
  """
  periods: Int
}

type TennisGameMetadata {
  format: TennisFormat!
  """
  Number of sets to win the match (3 or 5)
  """
  bestOf: Int!
  """
  Whether a tiebreak is played in the final set
  """
  tiebreakFinalSet: Boolean!
}

type FootballGameMetadata {
  format: FootballFormat!
  """
  Number of periods (e.g. 4 for quarters, 2 for halves)
  """
  periods: Int
}

type PickleballGameMetadata {
  format: PickleballFormat!
  """
  Number of games in match (1, 3, or 5)
  """
  bestOf: Int
  """
  Target score per game (11, 15, or 21)
  """
  pointsPerGame: Int
  """
  Whether win-by-two rule applies
  """
  winByTwo: Boolean
  """
  Scoring format (side-out or rally)
  """
  scoringType: PickleballScoringType
}

# ============================================================================
# Participant Metadata
# ============================================================================

"""
Sport-specific participant result data (scores, set wins, etc.).
Clients branch on Game.sportType and use inline fragments for sport-specific fields.
"""
union ParticipantMetadata =
  | BaseballParticipantMetadata
  | BasketballParticipantMetadata
  | TennisParticipantMetadata
  | FootballParticipantMetadata
  | PickleballParticipantMetadata

type BaseballParticipantMetadata {
  score: Int!
}

type BasketballParticipantMetadata {
  score: Int!
}

type TennisParticipantMetadata {
  setsWon: Int!
  sets: [TennisSetScore!]!
}

type TennisSetScore {
  gamesWon: Int!
  tiebreakPoints: Int
}

type FootballParticipantMetadata {
  score: Int!
}

type PickleballParticipantMetadata {
  gamesWon: Int!
  games: [PickleballGameScore!]!
}

type PickleballGameScore {
  pointsScored: Int!
}

"""
A grouping of players in a game. Is game-specific
"""
type TeamInstance implements Node & GameParticipant {
  id: ID!
  name: String!
  description: String
  players: [Player!]!
  metadata: ParticipantMetadata
}

type IndividualParticipant implements Node & GameParticipant {
  id: ID!
  player: Player!
  metadata: ParticipantMetadata
}

interface GameParticipant implements Node {
  id: ID!
  metadata: ParticipantMetadata
}

type GameParticipantEdge implements Edge {
  cursor: String!
  node: GameParticipant!
}

type GameParticipantConnection implements Connection {
  edges: [GameParticipantEdge!]!
  pageInfo: PageInfo!
}

"""
A game for a sport.
"""
type Game implements Node & HasLocation {
  id: ID!
  """
  Optional free-text description or notes for the game (e.g., "bring your own ball", "meet at court 3").
  """
  description: String
  startDate: DateTime!
  endDate: DateTime
  sportType: SportType!
  gameStatus: GameStatus!
  metadata: GameMetadata!
  location: Location
  """
  Whether this game is open for anyone with a player profile to join, or invite-only.
  """
  visibility: GameVisibility!
  """
  Whether the game organizer has locked scores and statistics from further edits by participants.
  """
  resultsFinalized: Boolean!
  """
  Who can enter statistics for this game.
  """
  statEntryMode: StatEntryMode!
  """
  Participants in a game. Relay / Connection pagination. Will either be teams or individuals
  """
  participants(
    first: Int
    after: String
    last: Int
    before: String
  ): GameParticipantConnection!
  livestreams(
    first: Int
    after: String
    last: Int
    before: String
  ): LivestreamConnection!
  """
  Media (photos, videos) attached to this game.
  """
  media(
    first: Int
    after: String
    last: Int
    before: String
  ): ResourceConnection!
  """
  The current user's friends who are players in this game.
  Returns an empty wrapper if the viewer is unauthenticated or has no friends in the game.
  Nodes are server-capped at 10 players; totalCount reflects the true number
  so the UI can render "Sarah, Kevin, and 3 others played basketball".
  """
  viewerFriendPlayers: ViewerFriendPlayers!
  """
  The current viewer's management role in this game, if any. Null if the viewer
  has no management role (or is unauthenticated). Independent from being a
  participant.
  """
  viewerGameRole: GameRole
  """
  Management members of this game (owner + editors). For the editor management screen.
  """
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): GameMemberConnection!
  """
  Invitations to this game. Only visible to organizers (owner/editor).
  Returns empty connection for non-managers.
  """
  invitations(
    status: GameInvitationStatus
    first: Int
    after: String
    last: Int
    before: String
  ): GameInvitationConnection!
  """
  The current viewer's invitation to this game, if any.
  Null if the viewer has no invitation (or is unauthenticated).
  Only returns PENDING or ACCEPTED invitations.
  """
  viewerInvitation: GameInvitation
}

type ViewerFriendPlayers {
  """
  First up to 10 friend players in this game.
  """
  nodes: [Player!]!
  """
  Total number of the viewer's friends who are players in this game.
  """
  totalCount: Int!
}

type GameEdge implements Edge {
  cursor: String!
  node: Game!
}

type GameConnection implements Connection {
  edges: [GameEdge!]!
  pageInfo: PageInfo!
}

"""
Fields to filter games by.
At least one filter must be provided — querying all games without any filter is not allowed.
"""
input GameFilterInput {
  """
  Inclusive
  """
  startAfter: DateTime
  """
  Inclusive
  """
  startBefore: DateTime
  """
  Equals
  """
  sportType: SportType
  """
  Equals - player is present in the game
  """
  playerId: ID
  """
  Equals
  """
  gameStatus: GameStatus
  """
  When true, only returns games where the current viewer is an OWNER or EDITOR.
  """
  organizedByMe: Boolean
  """
  When true, only returns games where the current viewer has a PENDING invitation (i.e., "needs response" filter).
  Does NOT include ACCEPTED invitations -- use myGames for the broader view.
  """
  invitedToMe: Boolean
  """
  When true, returns games where the current viewer is a participant, organizer, or has a PENDING/ACCEPTED invitation.
  Combines the effects of organizedByMe, playerId (for own player), and invitedToMe into a single unified filter.
  """
  myGames: Boolean
}

"""
Fields to sort a game by
"""
enum GameSortField {
  START_DATE
  GAME_STATUS
}

"""
Input to sort games
"""
input GameSortInput {
  field: GameSortField!
  direction: SortDirection = ASC
}

# ============================================================================
# Add Game Participant (Singular)
# ============================================================================

"""
Add a team instance to a game.
Use for team sports (5v5 basketball, doubles tennis, football).
"""
input AddTeamInstanceInput {
  gameId: ID!
  name: String!
  description: String
  playerIds: [ID!]
}

"""
Add an individual participant to a game.
Use for individual sports (singles tennis, 3v3 basketball).
"""
input AddIndividualParticipantInput {
  gameId: ID!
  playerId: ID!
}

"""
Add a participant to a game.
The participant type must match the game's format:
- Team sports (basketball, football, doubles tennis/pball, baseball): use teamInstance
- Individual sports (singles tennis, singles pball): use individual
"""
input AddGameParticipantInput @oneOf {
  teamInstance: AddTeamInstanceInput
  individual: AddIndividualParticipantInput
}

type AddGameParticipantResponse {
  participant: GameParticipant!
}

# ============================================================================
# Add Game Participants (Bulk)
# ============================================================================

"""
Team instance data for bulk add (gameId is at parent level).
"""
input AddTeamInstanceData {
  name: String!
  description: String
  playerIds: [ID!]
}

"""
Add multiple team instances to a game.
"""
input AddTeamInstancesInput {
  gameId: ID!
  teamInstances: [AddTeamInstanceData!]!
}

"""
Add multiple individual participants to a game.
"""
input AddIndividualParticipantsInput {
  gameId: ID!
  playerIds: [ID!]!
}

"""
Add multiple participants to a game.
The participant type must match the game's format.
Schema enforces that all participants in a batch are the same type.
"""
input AddGameParticipantsInput @oneOf {
  teamInstances: AddTeamInstancesInput
  individuals: AddIndividualParticipantsInput
}

type AddGameParticipantsResponse {
  participants: [GameParticipant!]!
}

# ============================================================================
# Update Game Participant (Singular)
# ============================================================================

"""
Update a team instance.
Fields not specified will not be updated.
"""
input UpdateTeamInstanceInput {
  id: ID!
  """
  If null will not be updated
  """
  name: String
  description: String
  playerIds: [ID!]
  """
  Sport-specific participant metadata (e.g. score).
  If null will not be updated.
  """
  metadata: ParticipantMetadataInput
}

"""
Update an individual participant.
"""
input UpdateIndividualParticipantInput {
  id: ID!
  """
  Sport-specific participant metadata (e.g. score, sets won).
  If null will not be updated.
  """
  metadata: ParticipantMetadataInput
}

"""
Update a participant in a game.
"""
input UpdateGameParticipantInput @oneOf {
  teamInstance: UpdateTeamInstanceInput
  individual: UpdateIndividualParticipantInput
}

type UpdateGameParticipantResponse {
  participant: GameParticipant!
}

# ============================================================================
# Update Game Participants (Bulk)
# ============================================================================

"""
Update multiple team instances.
"""
input UpdateTeamInstancesInput {
  teamInstances: [UpdateTeamInstanceInput!]!
}

"""
Update multiple individual participants.
"""
input UpdateIndividualParticipantsInput {
  individuals: [UpdateIndividualParticipantInput!]!
}

"""
Update multiple participants in a game.
Schema enforces that all participants in a batch are the same type.
"""
input UpdateGameParticipantsInput @oneOf {
  teamInstances: UpdateTeamInstancesInput
  individuals: UpdateIndividualParticipantsInput
}

type UpdateGameParticipantsResponse {
  participants: [GameParticipant!]!
}

# ============================================================================
# Remove Game Participant (Singular)
# ============================================================================

"""
Remove a team instance from a game.
"""
input RemoveTeamInstanceInput {
  id: ID!
}

"""
Remove an individual participant from a game.
"""
input RemoveIndividualParticipantInput {
  id: ID!
}

"""
Remove a participant from a game.
Must specify which type of participant is being removed.
"""
input RemoveGameParticipantInput @oneOf {
  teamInstance: RemoveTeamInstanceInput
  individual: RemoveIndividualParticipantInput
}

type RemoveGameParticipantResponse {
  id: ID!
}

# ============================================================================
# Remove Game Participants (Bulk)
# ============================================================================

"""
Remove multiple team instances from a game.
"""
input RemoveTeamInstancesInput {
  ids: [ID!]!
}

"""
Remove multiple individual participants from a game.
"""
input RemoveIndividualParticipantsInput {
  ids: [ID!]!
}

"""
Remove multiple participants from a game.
Schema enforces that all participants in a batch are the same type.
"""
input RemoveGameParticipantsInput @oneOf {
  teamInstances: RemoveTeamInstancesInput
  individuals: RemoveIndividualParticipantsInput
}

type RemoveGameParticipantsResponse {
  ids: [ID!]!
}

# ============================================================================
# Add Player to Team Instance (Singular)
# ============================================================================

"""
Add a player to an existing team instance.
"""
input AddPlayerToTeamInstanceInput {
  teamInstanceId: ID!
  playerId: ID!
}

type AddPlayerToTeamInstanceResponse {
  teamInstance: TeamInstance!
}

# ============================================================================
# Add Players to Team Instance (Bulk)
# ============================================================================

"""
Add multiple players to an existing team instance.
"""
input AddPlayersToTeamInstanceInput {
  teamInstanceId: ID!
  playerIds: [ID!]!
}

type AddPlayersToTeamInstanceResponse {
  teamInstance: TeamInstance!
}

