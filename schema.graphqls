# ============================================================================
# Game Subscription Events
# ============================================================================

interface GameEvent {
  """
  The game this event belongs to.
  """
  game: Game!
  """
  When the event occurred.
  """
  occurredAt: DateTime!
}

# --- Status events ---

type GameStartedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
}

type GameEndedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
}

type GameResultsFinalizedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
}

type GameResultsUnfinalizedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
}

"""
A league result was reported, re-reported, disputed or forfeited. Re-read Game.gameStatus, Game.result, Game.outcome and Game.viewerCan from `game` (a forfeit also moves gameStatus to FORFEITED).
"""
type GameResultChangedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
}

"""
The game was cancelled.
"""
type GameCancelledEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
}

# --- Score events ---

"""
Emitted when a participant's score/metadata is updated.
"""
type GameScoreUpdatedEvent implements GameEvent {
  game: Game!
  occurredAt: DateTime!
  """
  The participant whose score changed.
