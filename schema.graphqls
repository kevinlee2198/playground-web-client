interface ChatMessage implements Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
}

interface UserChatMessage implements ChatMessage & Node & HasUser {
  id: ID!
  chatRoom: ChatRoom!
  user: User!
  createdDate: DateTime!
  """
  if a user has edited their message this field will be present. It will not be present for deletion
  """
  updatedDate: DateTime
  """
  If a user has deleted their message this field will be present
  """
  deletedDate: DateTime
  """
  For threaded conversations
  """
  replyTo: UserChatMessage
}

type TextChatMessage implements UserChatMessage & ChatMessage & Node & HasUser {
  id: ID!
  chatRoom: ChatRoom!
  user: User!
  """
  Can be null if the message has been deleted
  """
  content: String
  createdDate: DateTime!
  """
  if a user has edited their message this field will be present. It will not be present for deletion
  """
  updatedDate: DateTime
  """
  If a user has deleted their message this field will be present
  """
  deletedDate: DateTime
  """
  For threaded conversations
  """
  replyTo: UserChatMessage
}

"""
A chat message with an attached file or image.
The resource's concrete type (ImageResource vs FileResource) indicates
the kind of media. Use inline fragments on the resource field:

```graphql
... on MediaChatMessage {
  caption
  resource {
    filename
    downloadUrl
    ... on ImageResource { width height thumbnailUrl }
  }
}
```
"""
type MediaChatMessage implements UserChatMessage & ChatMessage & Node & HasUser {
  id: ID!
  chatRoom: ChatRoom!
  user: User!
  createdDate: DateTime!
  """
  if a user has edited their message this field will be present. It will not be present for deletion
  """
  updatedDate: DateTime
  """
  If a user has deleted their message this field will be present
  """
  deletedDate: DateTime
  """
  For threaded conversations
  """
  replyTo: UserChatMessage
  """
  The attached file or image resource.
  """
  resource: Resource!
  """
  Optional caption for the media.
  """
  caption: String
}

interface SystemChatMessage implements ChatMessage & Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
}

type MemberJoinedChatMessage implements SystemChatMessage & ChatMessage & Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
  member: User!
}

type MemberLeftChatMessage implements SystemChatMessage & ChatMessage & Node {
  id: ID!
  chatRoom: ChatRoom!
  createdDate: DateTime!
  member: User!
}

type ChatMessageEdge implements Edge {
  cursor: String!
  node: ChatMessage!
}

type ChatMessageConnection implements Connection {
  edges: [ChatMessageEdge!]!
  pageInfo: PageInfo!
}

enum ChatRoomRole {
  OWNER
  ADMIN
  MEMBER
}

type ChatRoomMember implements HasUser & Node {
  id: ID!
  user: User!
  role: ChatRoomRole!
  joinedDate: DateTime!
}

type ChatRoomMemberEdge implements Edge {
  cursor: String!
  node: ChatRoomMember!
}

type ChatRoomMemberConnection implements Connection {
  edges: [ChatRoomMemberEdge!]!
  pageInfo: PageInfo!
}

interface ChatRoom implements Node {
  id: ID!
  createdDate: DateTime!
  lastModifiedDate: DateTime!
  """
  Members of the room
  """
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomMemberConnection!

  """
  Messages ordered by createdDate ASC.
  Use `last` to fetch the most recent chatMessages.
  """
  chatMessages(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatMessageConnection!
}

type DirectMessageChatRoom implements ChatRoom & Node {
  id: ID!
  createdDate: DateTime!
  lastModifiedDate: DateTime!
  """
  Whether the authenticated viewer can send messages in this DM.
  False when the mutual follow relationship is broken.
  """
  canMessage: Boolean!
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomMemberConnection!
  """
  Messages ordered by createdDate ASC.
  Use `last` to fetch the most recent messages; `before` to load older messages.
  """
  chatMessages(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatMessageConnection!
}

type GroupChatRoom implements ChatRoom & Node {
  id: ID!
  name: String!
  createdDate: DateTime!
  lastModifiedDate: DateTime!
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatRoomMemberConnection!
  """
  Messages ordered by createdDate ASC.
  Use `last` to fetch the most recent messages; `before` to load older messages.
  """
  chatMessages(
    first: Int
    after: String
    last: Int
    before: String
  ): ChatMessageConnection!
}

type ChatRoomEdge implements Edge {
  cursor: String!
  node: ChatRoom!
}

type ChatRoomConnection implements Connection {
  edges: [ChatRoomEdge!]!
  pageInfo: PageInfo!
}

input CreateDirectMessageInput {
  userId: ID!
}

type CreateDirectMessageResponse {
  chatRoom: ChatRoom!
}

input CreateGroupChatInput {
  name: String!
  userIds: [ID!]!
}

type CreateGroupChatResponse {
  chatRoom: ChatRoom!
}

input AddChatRoomMemberInput {
  chatRoomId: ID!
  userId: ID!
}

type AddChatRoomMemberResponse {
  member: ChatRoomMember!
}

input RemoveChatRoomMemberInput {
  chatRoomId: ID!
  userId: ID!
}

type RemoveChatRoomMemberResponse {
  chatRoomId: ID!
  userId: ID!
}

type SendChatMessageResponse {
  chatMessage: ChatMessage!
}

input SendTextChatMessageInput {
  chatRoomId: ID!
  content: String!
  replyToId: ID
}

"""
Send a media message. The resourceId must reference a resource that was
uploaded via requestUpload with a chatMedia context.
Sending the message also confirms the resource (transitions it to PERMANENT) —
do NOT call confirmUpload separately for chat media.
"""
input SendMediaChatMessageInput {
  chatRoomId: ID!
  """
  The resource ID returned from requestUpload.
  """
  resourceId: ID!
  caption: String
  replyToId: ID
}

"""
Polymorphic input for sending different types of chat messages.
Exactly one field must be provided.
"""
input SendChatMessageInput @oneOf {
  textMessage: SendTextChatMessageInput
  mediaMessage: SendMediaChatMessageInput
}

input UpdateTextChatMessageInput {
  id: ID!
  content: String!
}

"""
Polymorphic input for updating different types of chat messages.
Exactly one field must be provided.
"""
input UpdateChatMessageInput @oneOf {
  textMessage: UpdateTextChatMessageInput
}

type UpdateChatMessageResponse {
  chatMessage: ChatMessage!
}

input DeleteChatMessageInput {
  id: ID!
}

type DeleteChatMessageResponse implements DeleteResponse {
  id: ID!
}

interface ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
}

interface ChatMessageEvent implements ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  chatMessage: ChatMessage!
}

type ChatMessageSentEvent implements ChatMessageEvent & ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  chatMessage: ChatMessage!
}

type ChatMessageUpdatedEvent implements ChatMessageEvent & ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  chatMessage: ChatMessage!
}

type ChatMessageDeletedEvent implements ChatMessageEvent & ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  chatMessage: ChatMessage!
}

type ChatRoomMemberAddedEvent implements ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  member: ChatRoomMember!
}

type ChatRoomMemberRemovedEvent implements ChatEvent {
  chatRoom: ChatRoom!
  createdDate: DateTime!
  userId: ID!
}

input RenameChatRoomInput {
  chatRoomId: ID!
  name: String!
}

type RenameChatRoomResponse {
  chatRoom: ChatRoom!
}

input LeaveChatRoomInput {
  chatRoomId: ID!
}

type LeaveChatRoomResponse {
  chatRoomId: ID!
}

input UpdateChatRoomMemberRoleInput {
  chatRoomId: ID!
  userId: ID!
  role: ChatRoomRole!
}

type UpdateChatRoomMemberRoleResponse {
  """
  The updated ChatRoomMember record.
  """
  member: ChatRoomMember!
  """
  Only populated when transferring ownership — the previous owner's updated record (now a Member).
  """
  previousOwner: ChatRoomMember
}

# ============================================================================
# Chat Result Unions
# ============================================================================

union CreateDirectMessageResult =
  | CreateDirectMessageResponse
  | UserBlockedError
  | MutualFollowRequiredError
union CreateGroupChatResult = CreateGroupChatResponse | EmptyChatRoomError
union AddChatRoomMemberResult =
  | AddChatRoomMemberResponse
  | ChatRoomNotFoundError
  | DirectMessageNotAllowedError
  | MutualFollowRequiredError
union RemoveChatRoomMemberResult =
  | RemoveChatRoomMemberResponse
  | ChatRoomNotFoundError
  | UserNotFoundError
  | DirectMessageNotAllowedError
  | CannotRemoveOwnerError
  | InsufficientRoleError
union RenameChatRoomResult =
  | RenameChatRoomResponse
  | ChatRoomNotFoundError
  | DirectMessageNotAllowedError
union UpdateChatRoomMemberRoleResult =
  | UpdateChatRoomMemberRoleResponse
  | ChatRoomNotFoundError
  | UserNotFoundError
  | DirectMessageNotAllowedError
  | InvalidRoleTransitionError
union LeaveChatRoomResult =
  | LeaveChatRoomResponse
  | ChatRoomNotFoundError
  | UserNotFoundError
  | DirectMessageNotAllowedError
  | OwnerCannotLeaveError
union SendChatMessageResult =
  | SendChatMessageResponse
  | ChatRoomNotFoundError
  | MutualFollowRequiredError
union UpdateChatMessageResult =
  | UpdateChatMessageResponse
  | ChatMessageNotFoundError
  | MessageNotEditableError
union DeleteChatMessageResult =
  | DeleteChatMessageResponse
  | ChatMessageNotFoundError
"""
Common interface for all domain errors returned as part of result unions.
Clients can use `... on Error { message }` as a catch-all.
Infrastructure errors (UNAUTHORIZED, FORBIDDEN) remain in the GraphQL errors array.
"""
interface Error {
  message: String!
}

# ============================================================================
# Game Errors
# ============================================================================

type GameNotFoundError implements Error {
  message: String!
  gameId: ID!
}

type InvalidSportConfigError implements Error {
  message: String!
}

type InvalidDateRangeError implements Error {
  message: String!
}

type InvalidGameStatusTransitionError implements Error {
  message: String!
  currentStatus: GameStatus!
}

type PlayerNotFoundError implements Error {
  message: String!
  playerId: ID
  playerIds: [ID!]
}

type ParticipantNotFoundError implements Error {
  message: String!
  participantId: ID!
}

type TeamInstanceNotFoundError implements Error {
  message: String!
  teamInstanceId: ID!
}

type InvalidParticipantTypeError implements Error {
  message: String!
}

# ============================================================================
# User Errors
# ============================================================================

type UserNotFoundError implements Error {
  message: String!
  userId: ID!
}

type SelfActionError implements Error {
  message: String!
}

type BlockNotFoundError implements Error {
  message: String!
}

type MutualFollowRequiredError implements Error {
  message: String!
}

# ============================================================================
# Chat Errors
# ============================================================================

type ChatRoomNotFoundError implements Error {
  message: String!
  chatRoomId: ID!
}

type ChatMessageNotFoundError implements Error {
  message: String!
}

type DirectMessageNotAllowedError implements Error {
  message: String!
}

type UserBlockedError implements Error {
  message: String!
}

type EmptyChatRoomError implements Error {
  message: String!
}

type CannotRemoveOwnerError implements Error {
  message: String!
}

type InsufficientRoleError implements Error {
  message: String!
}

type InvalidRoleTransitionError implements Error {
  message: String!
  currentRole: ChatRoomRole!
  requestedRole: ChatRoomRole!
}

type OwnerCannotLeaveError implements Error {
  message: String!
}

type MessageNotEditableError implements Error {
  message: String!
}

# ============================================================================
# Notification Errors
# ============================================================================

type NotificationNotFoundError implements Error {
  message: String!
}

# ============================================================================
# Statistic Errors
# ============================================================================

type InvalidSportTypeError implements Error {
  message: String!
  expectedSportType: SportType!
  actualSportType: SportType!
}

# ============================================================================
# Resource Errors
# ============================================================================

type ResourceNotFoundError implements Error {
  message: String!
}

type InvalidUploadContextError implements Error {
  message: String!
}
type FollowRequest implements Node {
  id: ID!
  """
  The user who sent the follow request.
  """
  requester: User!
  """
  The user who received the follow request.
  """
  target: User!
  createdDate: DateTime!
}

type FollowRequestEdge implements Edge {
  cursor: String!
  node: FollowRequest!
}

type FollowRequestConnection implements Connection {
  edges: [FollowRequestEdge!]!
  pageInfo: PageInfo!
}

enum FollowRequestDirection {
  INCOMING
  OUTGOING
}

# ============================================================================
# Mutations
# ============================================================================

input ApproveFollowRequestInput {
  requestId: ID!
}

type ApproveFollowRequestResponse {
  follow: Follow!
}

input DeclineFollowRequestInput {
  requestId: ID!
}

type DeclineFollowRequestResponse implements DeleteResponse {
  id: ID!
}

input CancelFollowRequestInput {
  requestId: ID!
}

type CancelFollowRequestResponse implements DeleteResponse {
  id: ID!
}

# ============================================================================
# Response Types
# ============================================================================

type FollowRequestSentResponse {
  """
  Returned when the target has a private profile and a follow request was created.
  """
  followRequest: FollowRequest!
}

# ============================================================================
# Error Types
# ============================================================================

type FollowRequestNotFoundError implements Error {
  message: String!
  requestId: ID!
}

type FollowRequestAlreadyExistsError implements Error {
  message: String!
  requestId: ID!
}

type NotFollowRequestTargetError implements Error {
  message: String!
  requestId: ID!
}

type NotFollowRequestRequesterError implements Error {
  message: String!
  requestId: ID!
}

# ============================================================================
# Result Unions
# ============================================================================

union ApproveFollowRequestResult =
  | ApproveFollowRequestResponse
  | FollowRequestNotFoundError
  | NotFollowRequestTargetError
union DeclineFollowRequestResult =
  | DeclineFollowRequestResponse
  | FollowRequestNotFoundError
  | NotFollowRequestTargetError
union CancelFollowRequestResult =
  | CancelFollowRequestResponse
  | FollowRequestNotFoundError
  | NotFollowRequestRequesterError
# ============================================================================
# Game Media
#
# Unified content hub for game-related media: direct uploads, external video
# embeds, livestreams, and rich link previews. Replaces the previous
# Resource-based game.media connection and the separate Livestream entity.
#
# DESIGN: Interface + concrete types (not a single GameMedia type)
#
# Each content kind (image, video, livestream, link) has type-specific fields
# that only make sense for that kind. Rather than a single type with ~5
# nullable fields valid only for certain enum values, we use a GameMedia
# interface with four concrete types. This follows GraphQL best practices:
#
#   - __typename is the type discriminator, replacing the MediaType enum on
#     the entity. The runtime validates __typename; enums are unchecked.
#   - Clients use inline fragments to access type-specific fields, which is
#     self-documenting and IDE-friendly.
#   - Adding a new media kind means adding a new concrete type without
#     touching existing types.
#
# MediaStatus is also removed. A LivestreamMedia is always live by
# definition. When it ends, the backend changes the entity's type to VIDEO,
# and the GraphQL layer returns a VideoMedia. Status is implicit in
# __typename, eliminating a redundant field.
#
# The frontend uses plain fetch() + json-to-graphql-query with no normalized
# cache, so __typename changes during livestream-to-video transitions are
# free -- no cache invalidation needed.
# ============================================================================

# ============================================================================
# Enums
# ============================================================================

"""
Used ONLY on ResolveUrlResponse to tell the client what type of media was
detected before the entity is created. NOT a field on GameMedia or any
concrete type -- __typename is the type discriminator for persisted entities.
"""
enum MediaType {
  IMAGE
  VIDEO
  LIVESTREAM
  LINK
}

enum MediaSource {
  UPLOAD
  YOUTUBE
  TWITCH
  HUDL
  VIMEO
  TIKTOK
  INSTAGRAM
  CUSTOM_URL
}

# ============================================================================
# GameMedia Interface + Concrete Types
# ============================================================================

"""
Common fields shared by all game media items. Clients query the interface
for gallery listings and use inline fragments for type-specific fields:

    ... on VideoMedia { embedUrl embedWidth embedHeight }
    ... on LivestreamMedia { embedUrl embedWidth embedHeight }
    ... on LinkMedia { description }
"""
interface GameMedia implements Node {
  id: ID!
  source: MediaSource!
  """
  Content URL -- S3 presigned URL for uploads, external URL for everything else.
  """
  url: String!
  """
  Gallery thumbnail. Auto-generated for uploads, fetched via oEmbed for
  external providers, extracted from og:image for links.
  """
  thumbnailUrl: String
  """
  Display title. Optional for uploads, auto-populated from oEmbed/meta tags
  for external sources.
  """
  title: String
  """
  The user who added this media.
  """
  addedBy: User!
  """
  When this media was added.
  """
  createdAt: DateTime!
  """
  When this media was last updated.
  """
  updatedAt: DateTime
}

"""
An uploaded or externally-sourced image.
"""
type ImageMedia implements GameMedia & Node {
  id: ID!
  source: MediaSource!
  url: String!
  thumbnailUrl: String
  title: String
  addedBy: User!
  createdAt: DateTime!
  updatedAt: DateTime
}

"""
An uploaded or externally-sourced video. When a livestream ends, the backend
transitions the entity's type from LIVESTREAM to VIDEO -- the GraphQL layer
then returns a VideoMedia instead of LivestreamMedia.
"""
type VideoMedia implements GameMedia & Node {
  id: ID!
  source: MediaSource!
  url: String!
  thumbnailUrl: String
  title: String
  """
  Description from oEmbed/meta tags, or carried over from the livestream.
  """
  description: String
  addedBy: User!
  createdAt: DateTime!
  updatedAt: DateTime
  """
  Iframe src URL from oEmbed. Null for uploaded videos.
  """
  embedUrl: String
  """
  Embed width from oEmbed response.
  """
  embedWidth: Int
  """
  Embed height from oEmbed response.
  """
  embedHeight: Int
}

"""
A live stream. Always live by definition -- when it ends, the entity becomes
a VideoMedia. The embedUrl is always present because livestreams require an
embeddable player URL.
"""
type LivestreamMedia implements GameMedia & Node {
  id: ID!
  source: MediaSource!
  url: String!
  thumbnailUrl: String
  title: String
  """
  Description provided when starting the stream.
  """
  description: String
  addedBy: User!
  createdAt: DateTime!
  updatedAt: DateTime
  """
  Iframe src URL for the stream player. Always present for livestreams.
  """
  embedUrl: String!
  """
  Embed width from oEmbed response.
  """
  embedWidth: Int
  """
  Embed height from oEmbed response.
  """
  embedHeight: Int
}

"""
A rich link preview (article, Hudl film, any non-embeddable URL).
No embed fields -- links are never rendered as iframes.
"""
type LinkMedia implements GameMedia & Node {
  id: ID!
  source: MediaSource!
  url: String!
  thumbnailUrl: String
  title: String
  addedBy: User!
  createdAt: DateTime!
  updatedAt: DateTime
  """
  Description from oEmbed/meta tags.
  """
  description: String
}

type GameMediaEdge implements Edge {
  cursor: String!
  node: GameMedia!
}

type GameMediaConnection implements Connection {
  edges: [GameMediaEdge!]!
  pageInfo: PageInfo!
}

# ============================================================================
# URL Resolution (Phase 1 of Add Link flow)
#
# Client submits a URL. Backend resolves redirects, detects the provider,
# fetches oEmbed/OpenGraph data, checks for duplicates, and returns a
# preview for the user to confirm before creating the GameMedia item.
#
# This is a Query, not a Mutation -- it is a read-only operation that does
# not create or modify any state. The caller must have a role on the game
# (participant, editor, or owner) to resolve URLs for that game.
# ============================================================================

input ResolveUrlInput {
  """
  The URL pasted by the user.
  """
  url: String!
  """
  The game this link will be added to (for duplicate checking and authorization).
  """
  gameId: ID!
}

"""
Preview data returned after resolving a URL. The client displays this
for the user to confirm before calling addGameMediaLink.

The `type` field uses the MediaType enum to tell the client what kind of
media was detected. This is for preview purposes only -- once the entity is
created, __typename is the discriminator.
"""
type ResolveUrlResponse {
  """
  Detected media type (preview only -- not stored on the entity).
  """
  type: MediaType!
  """
  Detected provider/source.
  """
  source: MediaSource!
  """
  The final resolved URL (after following redirects).
  """
  resolvedUrl: String!
  """
  Display title from oEmbed or og:title.
  """
  title: String
  """
  Description from oEmbed or og:description.
  """
  description: String
  """
  Thumbnail URL from oEmbed or og:image.
  """
  thumbnailUrl: String
  """
  Iframe embed URL from oEmbed (null for links and uploads).
  """
  embedUrl: String
  """
  Embed width from oEmbed.
  """
  embedWidth: Int
  """
  Embed height from oEmbed.
  """
  embedHeight: Int
}

union ResolveUrlResult =
  | ResolveUrlResponse
  | GameNotFoundError
  | GameNotInProgressError
  | DuplicateMediaError
  | UrlResolutionError
  | RateLimitedError

# ============================================================================
# Add Game Media Link (Phase 2 of Add Link flow)
#
# After the user confirms the preview, client calls this to create the
# GameMedia record. The resolvedUrl is passed back so the backend can
# re-validate and avoid a TOCTOU race.
# ============================================================================

input AddGameMediaLinkInput {
  gameId: ID!
  """
  The resolved URL from the ResolveUrlResponse.
  """
  url: String!
}

type AddGameMediaLinkResponse {
  gameMedia: GameMedia!
}

union AddGameMediaLinkResult =
  | AddGameMediaLinkResponse
  | GameNotFoundError
  | GameNotInProgressError
  | DuplicateMediaError
  | UrlResolutionError
  | RateLimitedError

# ============================================================================
# Delete Game Media
#
# For UPLOAD sources: deletes the GameMedia record, the underlying Resource,
# and the S3 object. For external sources: deletes just the GameMedia record.
# ============================================================================

input DeleteGameMediaInput {
  id: ID!
}

type DeleteGameMediaResponse implements DeleteResponse {
  id: ID!
}

union DeleteGameMediaResult = DeleteGameMediaResponse | GameMediaNotFoundError

# ============================================================================
# Livestream Mutations (now operate on GameMedia)
#
# startLivestream creates a LivestreamMedia (type=LIVESTREAM in the DB).
# endLivestream transitions it to a VideoMedia (type=VIDEO in the DB).
# livestreamHeartbeat keeps it alive; missed heartbeats trigger auto-transition.
# ============================================================================

input StartLivestreamInput {
  gameId: ID!
  """
  YouTube or Twitch.
  """
  source: LivestreamSource!
  title: String!
  description: String
  """
  The stream/broadcast URL (e.g., youtube.com/live/abc).
  """
  url: String!
  """
  The embeddable URL for the stream player.
  """
  embedUrl: String!
}

"""
Restricted to providers that support livestreaming.
"""
enum LivestreamSource {
  YOUTUBE
  TWITCH
}

type StartLivestreamResponse {
  """
  The created livestream. Always a LivestreamMedia.
  """
  gameMedia: LivestreamMedia!
}

union StartLivestreamResult =
  | StartLivestreamResponse
  | GameNotFoundError
  | GameNotInProgressError

input EndLivestreamInput {
  """
  The GameMedia ID of the livestream.
  """
  id: ID!
}

type EndLivestreamResponse {
  """
  The transitioned media. Now a VideoMedia (was LivestreamMedia).
  """
  gameMedia: VideoMedia!
}

union EndLivestreamResult = EndLivestreamResponse | GameMediaNotFoundError

input UpdateLivestreamInput {
  """
  The GameMedia ID of the livestream.
  """
  id: ID!
  title: String
  description: String
}

type UpdateLivestreamResponse {
  gameMedia: GameMedia!
}

union UpdateLivestreamResult = UpdateLivestreamResponse | GameMediaNotFoundError

input LivestreamHeartbeatInput {
  """
  The GameMedia ID of the livestream.
  """
  id: ID!
}

type LivestreamHeartbeatResponse {
  """
  Echoes back the GameMedia to confirm it's still live.
  """
  gameMedia: GameMedia!
}

union LivestreamHeartbeatResult =
  | LivestreamHeartbeatResponse
  | GameMediaNotFoundError

# ============================================================================
# Confirm Game Media Upload
#
# Phase 2 of the upload flow specifically for game media.
# After the client uploads the file to S3, call confirmGameMediaUpload
# to transition the resource from REQUESTED to PERMANENT and create
# the GameMedia record.
# ============================================================================

input ConfirmGameMediaUploadInput {
  resourceId: ID!
}

type ConfirmGameMediaUploadResponse {
  gameMedia: GameMedia!
}

union ConfirmGameMediaUploadResult =
  | ConfirmGameMediaUploadResponse
  | ResourceNotFoundError
  | GameNotFoundError

# ============================================================================
# Error Types
# ============================================================================

"""
The resolved URL already exists as a GameMedia item in this game.
"""
type DuplicateMediaError implements Error {
  message: String!
  """
  Reference to the existing GameMedia item with this URL.
  """
  existingGameMediaId: ID!
}

"""
The URL could not be resolved -- invalid scheme, SSRF blocked, timeout,
unreachable, or unsupported format.
"""
type UrlResolutionError implements Error {
  message: String!
  """
  Machine-readable error code for client-side handling.
  """
  errorCode: UrlResolutionErrorCode!
}

"""
Granular error codes for URL resolution failures.
"""
enum UrlResolutionErrorCode {
  """
  URL scheme is not https.
  """
  INVALID_SCHEME
  """
  Resolved IP is in a private/reserved range (SSRF protection).
  """
  SSRF_BLOCKED
  """
  URL resolution timed out.
  """
  TIMEOUT
  """
  Host is unreachable or DNS resolution failed.
  """
  UNREACHABLE
  """
  Response format is not supported (e.g., binary content).
  """
  UNSUPPORTED_FORMAT
}

"""
Rate limit exceeded for link submissions.
"""
type RateLimitedError implements Error {
  message: String!
  """
  Seconds until the user can submit again.
  """
  retryAfterSeconds: Int!
}

type GameMediaNotFoundError implements Error {
  message: String!
}

"""
The game is not in a valid status for this operation (must be IN_PROGRESS or COMPLETE).
"""
type GameNotInProgressError implements Error {
  message: String!
}
"""
Management roles for a game, independent from being a participant.
"""
enum GameRole {
  OWNER
  EDITOR
}

"""
A user with a management role in a game.
"""
type GameMember implements HasUser & Node {
  id: ID!
  user: User!
  role: GameRole!
}

type GameMemberEdge implements Edge {
  cursor: String!
  node: GameMember!
}

type GameMemberConnection implements Connection {
  edges: [GameMemberEdge!]!
  pageInfo: PageInfo!
}

"""
What state a game is in.
"""
enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETE
  FINALIZED
}

"""
Controls who can discover, view, and join a game.
"""
enum GameVisibility {
  PUBLIC
  PROTECTED
  PRIVATE
}

"""
Who can enter statistics for a game.
"""
enum StatEntryMode {
  OPEN
  SELF_REPORT
  MANAGER_ONLY
}

"""
Different sport types supported by Playground
"""
enum SportType {
  BASEBALL
  BASKETBALL
  FOOTBALL
  TENNIS
  PICKLEBALL
  VOLLEYBALL
}

enum VolleyballFormat {
  INDOOR
  BEACH
}

enum BasketballFormat {
  FIVE_ON_FIVE
  THREE_ON_THREE
}

enum TennisFormat {
  SINGLES
  DOUBLES
}

enum FootballFormat {
  FLAG_FOOTBALL
  AMERICAN_FOOTBALL
}

enum PickleballFormat {
  SINGLES
  DOUBLES
}

enum PickleballScoringType {
  SIDE_OUT
  RALLY
}

# ============================================================================
# Game Metadata
# ============================================================================

"""
Sport-specific game configuration and rules.
Clients branch on Game.sportType and use inline fragments for sport-specific fields.
"""
union GameMetadata =
  | BaseballGameMetadata
  | BasketballGameMetadata
  | TennisGameMetadata
  | FootballGameMetadata
  | PickleballGameMetadata
  | VolleyballGameMetadata

type BaseballGameMetadata {
  """
  Number of innings
  """
  innings: Int
}

type BasketballGameMetadata {
  format: BasketballFormat!
  """
  Number of periods (e.g. 4 for quarters, 2 for halves)
  """
  periods: Int
}

type TennisGameMetadata {
  format: TennisFormat!
  """
  Number of sets to win the match (3 or 5)
  """
  bestOf: Int!
  """
  Whether a tiebreak is played in the final set
  """
  tiebreakFinalSet: Boolean!
}

type FootballGameMetadata {
  format: FootballFormat!
  """
  Number of periods (e.g. 4 for quarters, 2 for halves)
  """
  periods: Int
}

type PickleballGameMetadata {
  format: PickleballFormat!
  """
  Number of games in match (1, 3, or 5)
  """
  bestOf: Int
  """
  Target score per game (11, 15, or 21)
  """
  pointsPerGame: Int
  """
  Whether win-by-two rule applies
  """
  winByTwo: Boolean
  """
  Scoring format (side-out or rally)
  """
  scoringType: PickleballScoringType
}

type VolleyballGameMetadata {
  format: VolleyballFormat!
  bestOf: Int
  pointsPerSet: Int
  pointsPerFinalSet: Int
  winByTwo: Boolean
}

# ============================================================================
# Participant Metadata
# ============================================================================

"""
Sport-specific participant result data (scores, set wins, etc.).
Clients branch on Game.sportType and use inline fragments for sport-specific fields.
"""
union ParticipantMetadata =
  | BaseballParticipantMetadata
  | BasketballParticipantMetadata
  | TennisParticipantMetadata
  | FootballParticipantMetadata
  | PickleballParticipantMetadata
  | VolleyballParticipantMetadata

type BaseballParticipantMetadata {
  score: Int!
}

type BasketballParticipantMetadata {
  score: Int!
}

type TennisParticipantMetadata {
  setsWon: Int!
  sets: [TennisSetScore!]!
}

type TennisSetScore {
  gamesWon: Int!
  tiebreakPoints: Int
}

type FootballParticipantMetadata {
  score: Int!
}

type PickleballParticipantMetadata {
  gamesWon: Int!
  games: [PickleballGameScore!]!
}

type PickleballGameScore {
  pointsScored: Int!
}

type VolleyballParticipantMetadata {
  setsWon: Int!
  sets: [VolleyballSetScore!]!
}

type VolleyballSetScore {
  pointsScored: Int!
}

"""
A grouping of players in a game. Is game-specific
"""
type TeamInstance implements Node & GameParticipant {
  id: ID!
  name: String!
  description: String
  players: [Player!]!
  metadata: ParticipantMetadata
}

type IndividualParticipant implements Node & GameParticipant {
  id: ID!
  player: Player!
  metadata: ParticipantMetadata
}

interface GameParticipant implements Node {
  id: ID!
  metadata: ParticipantMetadata
}

type GameParticipantEdge implements Edge {
  cursor: String!
  node: GameParticipant!
}

type GameParticipantConnection implements Connection {
  edges: [GameParticipantEdge!]!
  pageInfo: PageInfo!
}

"""
A game for a sport.
"""
type Game implements Node & HasLocation {
  id: ID!
  """
  Optional free-text description or notes for the game (e.g., "bring your own ball", "meet at court 3").
  """
  description: String
  startDate: DateTime!
  endDate: DateTime
  sportType: SportType!
  gameStatus: GameStatus!
  metadata: GameMetadata!
  location: Location
  """
  Whether this game is open for anyone with a player profile to join, or invite-only.
  """
  visibility: GameVisibility!
  """
  Who can enter statistics for this game.
  """
  statEntryMode: StatEntryMode!
  """
  Participants in a game. Relay / Connection pagination. Will either be teams or individuals
  """
  participants(
    first: Int
    after: String
    last: Int
    before: String
  ): GameParticipantConnection!
  """
  Media (images, videos, livestreams, links) attached to this game.
  """
  media(
    first: Int
    after: String
    last: Int
    before: String
  ): GameMediaConnection!
  """
  The current user's followed users who are players in this game.
  Returns an empty wrapper if the viewer is unauthenticated or has no followed users in the game.
  Nodes are server-capped at 10 players; totalCount reflects the true number
  so the UI can render "Sarah, Kevin, and 3 others played basketball".
  """
  viewerFollowingPlayers: ViewerFollowingPlayers!
  """
  The current viewer's management role in this game, if any. Null if the viewer
  has no management role (or is unauthenticated). Independent from being a
  participant.
  """
  viewerGameRole: GameRole
  """
  Management members of this game (owner + editors). For the editor management screen.
  """
  members(
    first: Int
    after: String
    last: Int
    before: String
  ): GameMemberConnection!
  """
  Invitations to this game. Only visible to organizers (owner/editor).
  Returns empty connection for non-managers.
  """
  invitations(
    status: GameInvitationStatus
    first: Int
    after: String
    last: Int
    before: String
  ): GameInvitationConnection!
  """
  The current viewer's invitation to this game, if any.
  Null if the viewer has no invitation (or is unauthenticated).
  Only returns PENDING or ACCEPTED invitations.
  """
  viewerInvitation: GameInvitation
}

type ViewerFollowingPlayers {
  """
  First up to 10 following players in this game.
  """
  nodes: [Player!]!
  """
  Total number of the viewer's followed users who are players in this game.
  """
  totalCount: Int!
}

type GameEdge implements Edge {
  cursor: String!
  node: Game!
  """
  Distance in meters from the search center point to this game's location.
  Only present when the nearLocation filter was used in the query.
  Null on edges from queries that do not use nearLocation.
  """
  distance: Float
}

type GameConnection implements Connection {
  edges: [GameEdge!]!
  pageInfo: PageInfo!
}

input NearLocationInput {
  """
  Latitude of the search center point.
  """
  latitude: Float!
  """
  Longitude of the search center point.
  """
  longitude: Float!
  """
  Search radius in meters. Min: 160 (~0.1 mi). Max: 160934 (~100 mi).
  """
  radiusMeters: Float!
}

"""
Fields to filter games by.
At least one filter must be provided — querying all games without any filter is not allowed.
"""
input GameFilterInput {
  """
  Inclusive
  """
  startAfter: DateTime
  """
  Inclusive
  """
  startBefore: DateTime
  """
  Equals
  """
  sportType: SportType
  """
  Equals - player is present in the game
  """
  playerId: ID
  """
  Equals
  """
  gameStatus: GameStatus
  """
  When true, only returns games where the current viewer is an OWNER or EDITOR.
  """
  organizedByMe: Boolean
  """
  When true, only returns games where the current viewer has a PENDING invitation (i.e., "needs response" filter).
  Does NOT include ACCEPTED invitations -- use myGames for the broader view.
  """
  invitedToMe: Boolean
  """
  When true, returns games where the current viewer is a participant, organizer, or has a PENDING/ACCEPTED invitation.
  Combines the effects of organizedByMe, playerId (for own player), and invitedToMe into a single unified filter.
  """
  myGames: Boolean
  """
  Filter games by proximity to a geographic point.
  Only games with coordinates within the specified radius are returned.
  Games without coordinates are excluded when this filter is active.
  """
  nearLocation: NearLocationInput
}

"""
Fields to sort a game by
"""
enum GameSortField {
  START_DATE
  GAME_STATUS
  """
  Sort by distance from the search center point (nearest first).
  Only valid when the nearLocation filter is provided.
  """
  DISTANCE
}

"""
Input to sort games
"""
input GameSortInput {
  field: GameSortField!
  direction: SortDirection = ASC
}

# ============================================================================
# Add Game Participant (Singular)
# ============================================================================

"""
Add a team instance to a game.
Use for team sports (5v5 basketball, doubles tennis, football).
"""
input AddTeamInstanceInput {
  gameId: ID!
  name: String!
  description: String
  playerIds: [ID!]
}

"""
Add an individual participant to a game.
Use for individual sports (singles tennis, 3v3 basketball).
"""
input AddIndividualParticipantInput {
  gameId: ID!
  playerId: ID!
}

"""
Add a participant to a game.
The participant type must match the game's format:
- Team sports (basketball, football, doubles tennis/pball, baseball): use teamInstance
- Individual sports (singles tennis, singles pball): use individual
"""
input AddGameParticipantInput @oneOf {
  teamInstance: AddTeamInstanceInput
  individual: AddIndividualParticipantInput
}

type AddGameParticipantResponse {
  participant: GameParticipant!
}

# ============================================================================
# Add Game Participants (Bulk)
# ============================================================================

"""
Team instance data for bulk add (gameId is at parent level).
"""
input AddTeamInstanceData {
  name: String!
  description: String
  playerIds: [ID!]
}

"""
Add multiple team instances to a game.
"""
input AddTeamInstancesInput {
  gameId: ID!
  teamInstances: [AddTeamInstanceData!]!
}

"""
Add multiple individual participants to a game.
"""
input AddIndividualParticipantsInput {
  gameId: ID!
  playerIds: [ID!]!
}

"""
Add multiple participants to a game.
The participant type must match the game's format.
Schema enforces that all participants in a batch are the same type.
"""
input AddGameParticipantsInput @oneOf {
  teamInstances: AddTeamInstancesInput
  individuals: AddIndividualParticipantsInput
}

type AddGameParticipantsResponse {
  participants: [GameParticipant!]!
}

# ============================================================================
# Update Game Participant (Singular)
# ============================================================================

"""
Update a team instance.
Fields not specified will not be updated.
"""
input UpdateTeamInstanceInput {
  id: ID!
  """
  If null will not be updated
  """
  name: String
  description: String
  playerIds: [ID!]
  """
  Sport-specific participant metadata (e.g. score).
  If null will not be updated.
  """
  metadata: ParticipantMetadataInput
}

"""
Update an individual participant.
"""
input UpdateIndividualParticipantInput {
  id: ID!
  """
  Sport-specific participant metadata (e.g. score, sets won).
  If null will not be updated.
  """
  metadata: ParticipantMetadataInput
}

"""
Update a participant in a game.
"""
input UpdateGameParticipantInput @oneOf {
  teamInstance: UpdateTeamInstanceInput
  individual: UpdateIndividualParticipantInput
}

type UpdateGameParticipantResponse {
  participant: GameParticipant!
}

# ============================================================================
# Update Game Participants (Bulk)
# ============================================================================

"""
Update multiple team instances.
"""
input UpdateTeamInstancesInput {
  teamInstances: [UpdateTeamInstanceInput!]!
}

"""
Update multiple individual participants.
"""
input UpdateIndividualParticipantsInput {
  individuals: [UpdateIndividualParticipantInput!]!
}

"""
Update multiple participants in a game.
Schema enforces that all participants in a batch are the same type.
"""
input UpdateGameParticipantsInput @oneOf {
  teamInstances: UpdateTeamInstancesInput
  individuals: UpdateIndividualParticipantsInput
}

type UpdateGameParticipantsResponse {
  participants: [GameParticipant!]!
}

# ============================================================================
# Remove Game Participant (Singular)
# ============================================================================

"""
Remove a team instance from a game.
"""
input RemoveTeamInstanceInput {
  id: ID!
}

"""
Remove an individual participant from a game.
"""
input RemoveIndividualParticipantInput {
  id: ID!
}

"""
Remove a participant from a game.
Must specify which type of participant is being removed.
"""
input RemoveGameParticipantInput @oneOf {
  teamInstance: RemoveTeamInstanceInput
  individual: RemoveIndividualParticipantInput
}

type RemoveGameParticipantResponse {
  id: ID!
}

# ============================================================================
# Remove Game Participants (Bulk)
# ============================================================================

"""
Remove multiple team instances from a game.
"""
input RemoveTeamInstancesInput {
  ids: [ID!]!
}

"""
Remove multiple individual participants from a game.
"""
input RemoveIndividualParticipantsInput {
  ids: [ID!]!
}

"""
Remove multiple participants from a game.
Schema enforces that all participants in a batch are the same type.
"""
input RemoveGameParticipantsInput @oneOf {
  teamInstances: RemoveTeamInstancesInput
  individuals: RemoveIndividualParticipantsInput
}

type RemoveGameParticipantsResponse {
  ids: [ID!]!
}

