  periods: Int
}

input TennisGameMetadataInput {
  format: TennisFormat
  bestOf: Int
  tiebreakFinalSet: Boolean
}

input FootballGameMetadataInput {
  format: FootballFormat
  periods: Int
}

input PickleballGameMetadataInput {
  format: PickleballFormat
  bestOf: Int
  pointsPerGame: Int
  winByTwo: Boolean
  scoringType: PickleballScoringType
}

input CreateVolleyballGameMetadataInput {
  format: VolleyballFormat!
  bestOf: Int
  pointsPerSet: Int
  pointsPerFinalSet: Int
  winByTwo: Boolean
