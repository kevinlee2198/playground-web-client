  """
  Defaults to OPEN if not provided.
  """
  statEntryMode: StatEntryMode
}

"""
Create a football game
"""
input CreateFootballGameInput {
  startDate: DateTime!
  description: String
  location: LocationInput
  metadata: CreateFootballGameMetadataInput!
  """
  Defaults to PUBLIC if not provided.
  """
  visibility: GameVisibility
  """
  Defaults to OPEN if not provided.
  """
