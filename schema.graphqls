"""
A Playground user
"""
type User implements Node {
  id: ID!
  username: String!
  firstName: String!
  lastName: String!
  displayName: String!
  biography: String
  player: Player!
  friendship: Friendship
  """
  The user's profile picture. Null if no profile picture has been set.
  """
  profilePicture: Resource
}

"""
The current authenticated user with private fields
"""
type CurrentUser implements Node {
  id: ID!
  username: String!
  firstName: String!
  lastName: String!
  displayName: String!
  biography: String
  email: String!
  player: Player!
  """
  The user's profile picture. Null if no profile picture has been set.
  """
  profilePicture: Resource
}

"""
Something that is related to a user
"""
interface HasUser {
  user: User!
}

"""
The Friendship status between two users
"""
enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

"""
Direction of a friendship relative to the current user
"""
enum FriendshipDirection {
  """
  Requests sent TO the current user
  """
  INCOMING
  """
  Requests sent BY the current user
  """
  OUTGOING
}

"""
The Friendship between two users
Can be bidirectional - ACCEPTED status
Can be unidirectional - PENDING status
"""
type Friendship implements Node {
  id: ID!
  requester: User!
  addressee: User!
  status: FriendshipStatus!
  createdDate: DateTime!
}

type FriendshipEdge implements Edge {
  cursor: String!
  node: Friendship!
}

type FriendshipConnection implements Connection {
  edges: [FriendshipEdge!]!
  pageInfo: PageInfo!
}

"""
Filters for querying friendships
"""
input FriendshipFilterInput {
  """
  Filter by friendship status
  """
  status: FriendshipStatus
  """
  Filter by direction relative to current user.
  INCOMING = other users requested me, OUTGOING = I requested them.
  If null, returns both directions.
  """
  direction: FriendshipDirection
}

type UserEdge implements Edge {
  cursor: String!
  node: User!
}

type UserConnection implements Connection {
  edges: [UserEdge!]!
  pageInfo: PageInfo!
}

input SendFriendRequestInput {
  userId: ID!
}

type SendFriendRequestResponse {
  friendship: Friendship!
}

input AcceptFriendRequestInput {
  requesterId: ID!
}

type AcceptFriendRequestResponse {
  friendship: Friendship!
}

input DeclineFriendRequestInput {
  requesterId: ID!
}

type DeclineFriendRequestResponse {
  friendship: Friendship!
}

input UnfriendRequestInput {
  userId: ID!
}

type UnfriendResponse {
  friendship: Friendship
}

input CancelFriendRequestInput {
  """
  The user to whom the pending friend request was sent.
  """
  addresseeId: ID!
}

type CancelFriendRequestResponse {
  friendship: Friendship!
}

input BlockUserInput {
  userId: ID!
}

type BlockUserResponse {
  friendship: Friendship!
}

input UnblockUserInput {
  userId: ID!
}

type UnblockUserResponse {
  """
  The friendship relationship after unblocking, or null if there was no
  relationship to restore (e.g., there was no prior friendship).
  """
  friendship: Friendship
}

interface Notification implements Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
}

type FriendRequestReceivedNotification implements Notification & Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
  """
  The user who sent the friend request.
  """
  sender: User!
}

type FriendRequestAcceptedNotification implements Notification & Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
  """
  The user who accepted your friend request.
  """
  accepter: User!
}

type GameStartedNotification implements Notification & Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
  """
  The game that started.
  """
  game: Game!
}

type GameInvitationReceivedNotification implements Notification & Node {
  id: ID!
  isRead: Boolean!
  createdDate: DateTime!
  """
  The user who sent the invitation.
  """
  inviter: User!
  """
  The game the invitation is for.
  """
  game: Game!
  """
  The invitation itself. Null if the invitation was declined (deleted) after the notification was created.
  """
  invitation: GameInvitation
}

type NotificationEdge implements Edge {
  cursor: String!
  node: Notification!
}

type NotificationConnection implements Connection {
  edges: [NotificationEdge!]!
  pageInfo: PageInfo!
}

input ReadNotificationsInput {
  ids: [ID!]!
}

type ReadNotificationsResponse {
  notifications: [Notification!]!
}

type NotificationEvent {
  notification: Notification!
}

input QueryUserInput @oneOf {
  id: ID
  username: String
}

input UserSearchInput {
  query: String!
  #    excludeFriends: Boolean
  #    hasFriendshipStatus: FriendshipStatus
  #    hasPlayer: Boolean
}

"""
Update the current user's profile fields.
Fields not specified will not be updated.
"""
input UpdateUserInput {
  """
  Omit to leave unchanged. Setting to null will clear the biography.
  """
  biography: String
  """
  Omit to leave unchanged. Cannot be set to null.
  """
  displayName: String
}

type UpdateUserResponse {
  user: CurrentUser!
}

union UpdateUserResult = UpdateUserResponse

# ============================================================================
# Friendship Result Unions
# ============================================================================

union SendFriendRequestResult =
  | SendFriendRequestResponse
  | UserNotFoundError
  | SelfActionError
  | FriendshipAlreadyExistsError
union AcceptFriendRequestResult =
  | AcceptFriendRequestResponse
  | FriendRequestNotFoundError
  | InvalidFriendshipStateError
union DeclineFriendRequestResult =
  | DeclineFriendRequestResponse
  | FriendRequestNotFoundError
  | InvalidFriendshipStateError
union UnfriendResult = UnfriendResponse | SelfActionError
union CancelFriendRequestResult =
  | CancelFriendRequestResponse
  | FriendRequestNotFoundError
  | InvalidFriendshipStateError
union BlockUserResult =
  | BlockUserResponse
  | SelfActionError
  | UserBlockedYouError
union UnblockUserResult =
  | UnblockUserResponse
  | BlockNotFoundError
  | UserBlockedYouError

# ============================================================================
# Notification Result Unions
# ============================================================================

union ReadNotificationsResult =
  | ReadNotificationsResponse
  | NotificationNotFoundError
