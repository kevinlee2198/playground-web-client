  gameId: ID!
  aces: Int
  faults: Int
  doubleFaults: Int
  pointsWon: Int
  winners: Int
  unforcedErrors: Int
  forcedErrors: Int
  dinks: Int
  drives: Int
  drops: Int
  lobs: Int
  volleys: Int
  overheads: Int
}

"""
Pickleball statistics data for a single player within a bulk save (gameId is at parent level).
